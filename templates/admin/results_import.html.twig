{% extends '@EasyAdmin/layout.html.twig' %}

{% block main %}
<div class="container mt-4">
    <h1>Importer des résultats</h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}
    <form method="post" action="{{ path('admin_results_import_page') }}" enctype="multipart/form-data">
        <div class="mb-3">
            <label for="test" class="form-label">Epreuve</label>
            <select name="test_id" id="test" class="form-select" required>
                <option value="">-- Choisir une épreuve --</option>
                {% for compGroup in competitions %}
                    <optgroup label="{{ compGroup.competition.name }}">
                        {% for test in compGroup.tests %}
                            {% if not test.isResultsValidated %}
                                <option value="{{ test.id }}">
                                    {{ compGroup.competition.name }} - {{ test.code }}
                                </option>
                            {% endif %}
                        {% endfor %}
                    </optgroup>
                {% endfor %}
            </select>
        </div> 
 
        <div class="mb-3" style="max-width: 400px;">
            <label for="csv_file" class="form-label">Fichier CSV</label>
            <input type="file" name="csv_file" id="csv_file" accept=".csv" class="form-control border border-dark" required>
        </div>

        <button type="submit" class="btn btn-primary">Importer</button>
    </form>
</div>

{% endblock %}