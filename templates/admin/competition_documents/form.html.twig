{% extends 'base.html.twig' %}

{% block body %}

<div class="container mt-5">

    <div class="card shadow-sm">

        <div class="card-header">
            <h4 class="mb-0">
                Ajouter un document
            </h4>
        </div>

        <div class="card-body">

            <div class="mb-3">
                <strong>Compétition :</strong>
                {{ competition.name }}
            </div>

            {{ form_start(form) }}

            <div class="mb-4">
                {{ form_label(form.type) }}

                {% for choice in form.type %}
                    <div class="form-check">
                        {{ form_widget(choice, {
                            attr: {
                                class: 'form-check-input'
                            }
                        }) }}
                        {{ form_label(choice, null, {
                            label_attr: {
                                class: 'form-check-label'
                            }
                        }) }}
                    </div>
                {% endfor %}

                {{ form_errors(form.type) }}
            </div>

            <div class="form-check form-switch mb-4">
                {{ form_widget(form.public, {
                    attr: {
                        class: 'form-check-input'
                    }
                }) }}

                {{ form_label(form.public, 'Visible par les concurrents', {
                    label_attr: {
                        class: 'form-check-label'
                    }
                }) }}

                {{ form_errors(form.public) }}
            </div>

            <div class="mb-4">
                {{ form_label(form.documentFile) }}

                {{ form_widget(form.documentFile, {
                    attr: {
                        class: 'form-control'
                    }
                }) }}

                {{ form_errors(form.documentFile) }}
            </div>

            <div class="mt-4">

                <button class="btn btn-primary">
                    <i class="fa fa-save"></i>
                    Enregistrer
                </button>

<a class="btn btn-secondary"
   href="{{ returnUrl }}">
    Annuler
</a>

            </div>

            {{ form_end(form) }}

        </div>

    </div>

</div>

{% endblock %}