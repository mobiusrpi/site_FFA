{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}
{{ test.competition.name }} - Scores - {{ test.name }}
{% endblock %}


{% block main %}

    {% set competType = test.competition.typecompetition.id %}
    {% set isANR = competType == 3 %}

    {% set showNav = test.type in [
        constant('App\\Entity\\Enum\\TestCompet::NAVIGATION'),
        constant('App\\Entity\\Enum\\TestCompet::NAV_ATT'),
        constant('App\\Entity\\Enum\\TestCompet::NAV_TG')
    ] %}

    {% set showObs = showNav and not isANR %}

    {% set showTheo = (test.type in [
        constant('App\\Entity\\Enum\\TestCompet::NAVIGATION')
    ]) and not isANR %}

    {% set showAtt = test.type in [
        constant('App\\Entity\\Enum\\TestCompet::LANDING'),
        constant('App\\Entity\\Enum\\TestCompet::NAV_ATT'),
        constant('App\\Entity\\Enum\\TestCompet::NAV_TG')
    ] or (isANR and showNav) %} 
    


    <div class="card">
        <div class="card-body">
            <form method="post">

                <table class="table">
                    <thead>
                        <tr>
                            <th class="text-center sort-column" data-key="id">
                                <span class="d-inline-flex align-items-center justify-content-center">
                                    Id
                                    <i class="fa-solid fa-sort sort-arrow ms-2" style="cursor:pointer;"></i>
                                </span>
                            </th>
                            <th class="text-center sort-column" data-key="crew">
                                <span class="d-inline-flex align-items-center justify-content-center">
                                    {% if competType == 2 %}
                                        Pilote
                                    {% else %}
                                        Équipage
                                    {% endif %}
                                    <i class="fa-solid fa-sort sort-arrow ms-2" style="cursor:pointer;"></i>
                                </span>
                            </th>
                            <th class="text-center sort-column" data-key="category">
                                <span class="d-inline-flex align-items-center justify-content-center">
                                    Catégorie
                                    <i class="fa-solid fa-sort sort-arrow ms-2" style="cursor:pointer;"></i>
                                </span>
                            </th>
                            <th>DNS</th>
                            <th>DNF</th>
                            {% if showNav %}
                                <th>Nav</th>
                            {% endif %}
                            {% if (showObs) and (competType != 3) %}
                                <th>Obs</th>
                            {% endif %}
                            {% if showTheo %}
                                <th>Théo</th>
                            {% endif %}
                            {% if showAtt %}
                                <th>Att</th>
                            {% endif %}

                            <th class="text-center sort-column" data-key="category">
                                <span class="d-inline-flex align-items-center justify-content-center">
                                    Total
                                    <i class="fa-solid fa-sort sort-arrow ms-2" style="cursor:pointer;"></i>
                                </span>
                            </th>
                            <th>
                                <span class="d-inline-flex align-items-center justify-content-center">
                                    Ajout 
                                    <input type="checkbox" id="checkAllNew" class="form-check-input ms-1">
                                </span>
                            </th>
                           <th>
                                <span class="d-inline-flex align-items-center justify-content-center">
                                    Supprime 
                                    <input type="checkbox" id="checkAllDelete" class="form-check-input ms-1">
                                </span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                            <data-initial-order="{loop.index }}">
                                {% set penalty = 0 %}
                            
                                <td class="text-center" data-value="{{ row.crew.id ?? -1 }}"> 
                                    {{ row.crew.id }}
                                </td>
                                <td class="text-center" data-value="{{ row.crew.pilot.lastname ?? -1 }}"> 
                                    {% if competType == 2 %}
                                        {{ row.crew.pilot.lastname ?? '' }}
                                        {{ row.crew.pilot.firstname ?? '' }}
                                    {% else %}
                                        {{ row.crew.pilot.lastname ?? '' }}
                                        {{ row.crew.pilot.firstname ?? '' }}<br>
                                        {{ row.crew.navigator.lastname ?? '' }}
                                        {{ row.crew.navigator.firstname ?? '' }}
                                    {% endif %}
                                </td>   
                                <td class="text-center" data-value="{{ row.crew.category.label ?? -1 }}"> 
                                    {{ row.crew.category.label ?? '' }}
                                </td>
                                <td>
                                    <input type="checkbox"
                                        name="results[{{ row.crew.id }}][dns]"
                                        class="form-check-input"
                                        value="1"
                                        {% if row.scores and row.scores.dns == -1 %} checked {% endif %}>
                                </td>
                                <td>
                                    <input type="checkbox"
                                        name="results[{{ row.crew.id }}][dnf]"
                                        class="form-check-input"
                                        value="1"
                                        {% if row.scores and row.scores.dns == 1 %} checked {% endif %}>
                                </td>
                                {% if showNav %}
                                    <td>
                                        <input type="number"
                                        name="results[{{ row.crew.id }}][navigation]"
                                        value="{{ row.scores ? row.scores.navigation : 0 }}"
                                        class="score-input nav form-control form-control-sm">
                                    </td>
                                    {% set penalty = penalty + (row.scores ? row.scores.navigation|default(0) : 0) %}
                                {% endif %}

                                {% if showObs %}
                                    <td>
                                        <input type="number"
                                        name="results[{{ row.crew.id }}][observation]"
                                        value="{{ row.scores ? row.scores.observation : 0 }}"
                                        class="score-input obs form-control form-control-sm">
                                    </td>
                                    {% set penalty = penalty + (row.scores ? row.scores.observation|default(0) : 0) %}
                                {% endif %}

                                {% if showTheo %}
                                    <td>
                                        <input type="number"
                                        name="results[{{ row.crew.id }}][flightPlanning]"
                                        value="{{ row.scores ? row.scores.flightPlanning : 0 }}"
                                        class="score-input nav form-control form-control-sm">
                                    </td>
                                    {% set penalty = penalty + (row.scores ? row.scores.flightPlanning|default(0) : 0) %}
                                    {% endif %}

                                {% if showAtt %}
                                    <td>
                                        <input type="number"
                                        name="results[{{ row.crew.id }}][landing]"
                                        value="{{ row.scores ? row.scores.landing : 0 }}"
                                        class="score-input att form-control form-control-sm">
                                    </td>
                                    {% set penalty = penalty + (row.scores ? row.scores.landing|default(0) : 0) %}
                                {% endif %}

                                <td class="total"><strong>{{ penalty }}</strong></td>

                                <td>
                                    {% if row.isNew %}
                                        <input type="checkbox"
                                        name="results[{{ row.crew.id }}][isNew]"
                                        class="form-check-input is-new-checkbox">
                                    {% endif %}
                                </td>
                                <td>
                                    {% if not row.isNew %}
                                        <input type="checkbox"
                                        name="results[{{ row.crew.id }}][isDelete]"
                                        class="form-check-input is-delete-checkbox">
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>

                <button type="submit" class="btn btn-success">
                    Enregistrer les modifications
                </button>
                <button type="button" class="btn btn-online" onclick="history.back();">
                    Retour
                </button>

            </form>
        </div>
    </div>
    <script>
        // Mettre à jour le total à chaque modification
        document.addEventListener('DOMContentLoaded', function() {

            const checkAllNew = document.getElementById('checkAllNew');
            const checkAllDelete = document.getElementById('checkAllDelete');

            if (checkAllNew) {
                checkAllNew.addEventListener('change', function () {

                    document.querySelectorAll('.is-new-checkbox').forEach(cb => {
                        cb.checked = this.checked;
                    });

                });
            }

            if (checkAllDelete) {
                checkAllDelete.addEventListener('change', function () {

                    document.querySelectorAll('.is-delete-checkbox').forEach(cb => {
                        cb.checked = this.checked;
                    });

                });
            }

            document.querySelectorAll('.score-input').forEach(input => {
                input.addEventListener('input', function() {
                    const row = this.closest('tr');

                    const nav = parseInt(row.querySelector('.nav').value) || 0;
                    const obs = parseInt(row.querySelector('.obs').value) || 0;
                    const att = parseInt(row.querySelector('.att').value) || 0;

                    const total = nav + obs + att;

                    row.querySelector('.total').textContent = total;
                });
            });

            // Sélectionner toutes les tables
            document.querySelectorAll('.table').forEach(table => {

                const headers = table.querySelectorAll('th.sort-column');

                headers.forEach(header => {

                    const key = header.dataset.key;
                    const icon = header.querySelector('.sort-arrow');

                    if (!key || !icon) return;

                    let ascending = true;

                    header.addEventListener('click', function () {

                        const tbody = table.querySelector('tbody');
                        const rows = Array.from(tbody.querySelectorAll('tr'));

                        const columnIndex = Array.from(header.parentNode.children).indexOf(header);

                        rows.sort((a, b) => {

                            const aCell = a.children[columnIndex];
                            const bCell = b.children[columnIndex];

                            const aVal = (aCell.dataset.value ?? aCell.textContent).trim();
                            const bVal = (bCell.dataset.value ?? bCell.textContent).trim();

                            const aNum = parseFloat(aVal);
                            const bNum = parseFloat(bVal);

                            let result;

                            // tri principal
                            if (!isNaN(aNum) && !isNaN(bNum)) {
                                result = aNum - bNum;
                            } else {
                                result = aVal.localeCompare(bVal, 'fr', { sensitivity: 'base' });
                            }

                            // inversion uniquement du tri principal
                            if (!ascending) {
                                result = -result;
                            }

                            // tri secondaire équipage (toujours croissant)
                            if (result === 0) {

                                const crewIndex = table.querySelector('th[data-key="crew"]').cellIndex;

                                const aCrew = (a.children[crewIndex].dataset.value ?? a.children[crewIndex].textContent).trim();
                                const bCrew = (b.children[crewIndex].dataset.value ?? b.children[crewIndex].textContent).trim();

                                result = aCrew.localeCompare(bCrew, 'fr', { sensitivity: 'base' });
                            }

                            return result;
                        });

                        ascending = !ascending;

                        rows.forEach(row => tbody.appendChild(row));

                        // reset icones
                        headers.forEach(h => {
                            const i = h.querySelector('.sort-arrow');
                            if (i) {
                                i.classList.remove('fa-sort-up','fa-sort-down');
                                i.classList.add('fa-sort');
                            }
                        });

                        icon.classList.remove('fa-sort');
                        icon.classList.add(ascending ? 'fa-sort-up' : 'fa-sort-down');

                    });

                });

            });
            document.querySelectorAll('table tbody tr').forEach(row => {
                const dnsCheckbox = row.querySelector('input[name$="[dns]"]');
                const dnfCheckbox = row.querySelector('input[name$="[dnf]"]');

                if (!dnsCheckbox || !dnfCheckbox) return;

                dnsCheckbox.addEventListener('change', () => {
                    if (dnsCheckbox.checked) dnfCheckbox.checked = false;
                });

                dnfCheckbox.addEventListener('change', () => {
                    if (dnfCheckbox.checked) dnsCheckbox.checked = false;
                });
            });
        });
        document.querySelectorAll('.is-delete-checkbox').forEach(cb => {
            cb.addEventListener('change', function() {
                const row = this.closest('tr');
                if (!row) return;

                const dnsCheckbox = row.querySelector('input[name$="[dns]"]');
                const dnfCheckbox = row.querySelector('input[name$="[dnf]"]');

                if (this.checked) {
                    if (dnsCheckbox) dnsCheckbox.checked = false;
                    if (dnfCheckbox) dnfCheckbox.checked = false;
                }
            });
        });
    </script>
{% endblock %}