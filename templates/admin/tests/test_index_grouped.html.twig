{# templates/admin/test_index_grouped.html.twig #}
{% extends '@EasyAdmin/layout.html.twig' %}

{% block flash_messages %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}
{% endblock %}

{% block content_title %}
    Epreuves par compétition
{% endblock %}

{% block main %}

    {% for competitionId, groupData in grouped %}
        <h5 class="d-flex justify-content-between align-items-center mb-2">
            {{ groupData.competition.name}}

            <a href="{{ ea_url()
                    .setController('App\\Controller\\Admin\\TestsCrudController')
                    .setAction('new')
                    .set('competition', groupData.competition.id)
                }}" 
                class="btn btn-sm btn-primary">
                    <i class="fas fa-plus"></i> Ajouter une épreuve
            </a>
        </h5>
        <table class="table">
            <thead>
                <tr>
                    <th>Id</th>                     
                    <th>Name</th>                      
                    <th>Code</th>     
                    <th>Type d'épreuve</th>                  
                    <th>En cours</th>                          
                    <th>Resultats validés</th>                    
                </tr>
            </thead>
            <tbody>
                {% for test in groupData.tests %}
                    <tr>
                        <td>{{ test.id }}</td>                        
                        <td>{{ test.name }}</td>                          
                        <td>{{ test.code }}</td>                          
                        <td>{{ test.type.value }}</td>                         
        
                        <td>
                            <input type="checkbox"
                                class="form-check-input toggle-switch"
                                data-test-id="{{ test.id }}"
                                data-field="inProgress"
                                {% if test.inProgress %}checked{% endif %}>
                        </td>

                        <td>
                            <input type="checkbox"
                                class="form-check-input toggle-switch"
                                data-test-id="{{ test.id }}"
                                data-field="resultsValidated"
                                {% if test.resultsValidated %}checked{% endif %}>
                        </td>
                     
                        <td>
                            <div class="d-flex gap-2">
 <a href="{{ ea_url().setAction('edit').setEntityId(test.id) }}"
   class="btn btn-sm btn-primary edit-test {% if test.resultsValidated %}disabled btn-secondary{% endif %}"
   {% if test.resultsValidated %}
       tabindex="-1"
       aria-disabled="true"
       title="Résultats validés"
       onclick="return false;"
   {% endif %}>
    Modifier
</a>

<a href="{{ ea_url().setAction('updateScores').setEntityId(test.id) }}"
   class="btn btn-sm btn-primary scores-test {% if test.resultsValidated %}disabled btn-secondary{% endif %}"
   {% if test.resultsValidated %}
       tabindex="-1"
       aria-disabled="true"
       title="Résultats validés"
       onclick="return false;"
   {% endif %}>
    Scores
</a>

<form method="post"
      class="delete-test"
      action="{{ ea_url()
                 .setController('App\\Controller\\Admin\\TestsCrudController')
                 .setAction('delete')
                 .setEntityId(test.id) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ test.id) }}">
    <button class="btn btn-sm btn-outline text-danger"
            {% if test.resultsValidated %}
                disabled aria-disabled="true" title="Résultats validés"
            {% endif %}>
        <i class="fas fa-trash"></i> Supprimer
    </button>
</form>             
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        <div class="modal fade" id="passwordModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmer la validation</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label for="passwordInput">Mot de passe :</label>
                    <input type="password" id="passwordInput" class="form-control" placeholder="Entrez votre mot de passe">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="button" class="btn btn-primary" id="confirmPasswordBtn">Confirmer</button>
                </div>
                </div>
            </div>
            </div>
    {% endfor %}
    <script>
        let currentSwitch = null;
        let currentField = null;
        let currentTestId = null;

        document.addEventListener('DOMContentLoaded', function () {

            // Initialisation des toggle-switch
            document.querySelectorAll('.toggle-switch').forEach(function (switchEl) {
                switchEl.dataset.initial = switchEl.checked ? '1' : '0';

                switchEl.addEventListener('change', function () {
                    const testId = this.dataset.testId;
                    const field = this.dataset.field;
                    const initial = this.dataset.initial === '1';

                    // Si field = resultsValidated et on coche
                    if (field === 'resultsValidated' && !initial && this.checked) {
                        currentSwitch = this;
                        currentField = field;
                        currentTestId = testId;

                        const passwordInput = document.getElementById('passwordInput');
                        passwordInput.value = '';

                        const modalEl = document.getElementById('passwordModal');
                        const modal = new bootstrap.Modal(modalEl);

                        modalEl.addEventListener('hidden.bs.modal', function () {
                            if (currentSwitch) {
                                currentSwitch.checked = false;
                                currentSwitch = null;
                                currentField = null;
                                currentTestId = null;
                            }
                        }, { once: true });

                        modal.show();
                    } else {
                        toggleField(testId, field, null, this);
                    }
                });
            });

            // Bouton confirmer du modal
            document.getElementById('confirmPasswordBtn').addEventListener('click', function () {
                const password = document.getElementById('passwordInput').value;
                if (!password) return;

                toggleField(currentTestId, currentField, password, currentSwitch);

                const modalEl = document.getElementById('passwordModal');
                const modal = bootstrap.Modal.getInstance(modalEl);
                modal.hide();

                currentSwitch = null;
                currentField = null;
                currentTestId = null;
            });

        });

        // Fonction toggle générique
        function toggleField(testId, field, password, switchEl) {
            fetch(`/admin/tests/toggle/${testId}/${field}`, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/json' },
                body: JSON.stringify({ password: password })
            })
            .then(res => res.json())
            .then(data => {
                if (!data.success) {
                    alert(data.error || 'Erreur lors de la mise à jour');
                    if (switchEl) switchEl.checked = !switchEl.checked;
                } else {
                    if (switchEl) switchEl.dataset.initial = switchEl.checked ? '1' : '0';

                    if (field === 'resultsValidated') {
                        const row = switchEl.closest('tr');
                        const editBtn = row.querySelector('.edit-test');
                        const scoresBtn = row.querySelector('.scores-test');
                        const deleteBtn = row.querySelector('.delete-test button');

                        if (switchEl.checked) {
                            [editBtn, scoresBtn].forEach(btn => {
                                if (btn) {
                                    btn.classList.add('disabled','btn-secondary');
                                    btn.setAttribute('tabindex','-1');
                                    btn.setAttribute('aria-disabled','true');
                                    btn.style.pointerEvents = 'none';
                                    btn.title = 'Résultats validés';
                                }
                            });
                            if (deleteBtn) {
                                deleteBtn.disabled = true;
                                deleteBtn.setAttribute('aria-disabled','true');
                                deleteBtn.title = 'Résultats validés';
                            }
                        } else {
                            [editBtn, scoresBtn].forEach(btn => {
                                if (btn) {
                                    btn.classList.remove('disabled','btn-secondary');
                                    btn.removeAttribute('tabindex');
                                    btn.removeAttribute('aria-disabled');
                                    btn.style.pointerEvents = '';
                                    btn.title = '';
                                }
                            });
                            if (deleteBtn) {
                                deleteBtn.disabled = false;
                                deleteBtn.removeAttribute('aria-disabled');
                                deleteBtn.title = '';
                            }
                        }
                    }
                }
            });
        }
    </script>
{% endblock %}