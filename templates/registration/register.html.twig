{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
   <style>
        .smaller-text {
            font-size: 0.8em; 
        }
        .required-field {
            border: 1px solid orange !important;
            box-shadow: 0 0 5px orange;
        }
    </style>

    <section class='container mt-4' >
        <h3 class="h3 text-center font-weight-normal mb-3">M'inscrire</h3> 
        {% if registrationForm.vars.errors|length > 0 %}
            <div class="alert alert-danger">
                {{ form_errors(registrationForm) }}
            </div>
        {% endif %}
        {{ form_start(registrationForm) }}
        <div class="row justify-content-center">
            <div class="col-md-5 border border-dark border-1 rounded-3 order-1 order-md-1 mb-3 p-4 me-2">
                <h4 class="text-center font-weight-normal mb-3">Enregistrement</h4> 
                {{ form_label(registrationForm.email) }}                               
                <div class='text-danger'>  
                    {{ form_errors(registrationForm.email) }}   
                </div> 
                {{ form_widget(registrationForm.email) }}

                {{ form_label(registrationForm.lastname) }}               
                <div class='text-danger'>                
                    {{ form_errors(registrationForm.lastname) }}
                </div>
                {{ form_widget(registrationForm.lastname) }}
 
                {{ form_label(registrationForm.firstname) }}            
                <div class='text-danger'>                    
                    {{ form_errors(registrationForm.firstname) }}
                </div>
                {{ form_widget(registrationForm.firstname) }}

                {{ form_label(registrationForm.plainPassword) }}              
                <div class='text-danger'>                
                    {{ form_errors(registrationForm.plainPassword) }}
                </div>
                {{ form_widget(registrationForm.plainPassword) }}
 
                <div class="col border border-dark text-center rounded-3 p-2 bg-secondary text-white form-check mt-4">
                    {{ form_row(registrationForm.isCompetitor) }}
                </div>
            </div>                   
            <div class="col-md-6 border border-dark border-1 rounded-3 order-2 order-md-2  p-4 ms-2" id='competitorFieldsContainer'>
                <h4 class="text-center font-weight-normal mb-3">Informations additionnelles pour les compétiteurs</h4>              

                {{ form_label(registrationForm.birthdate) }}
                <div class='text-danger'> 
                    {{ form_errors(registrationForm.birthdate) }}   
                </div>             
                {{ form_widget(registrationForm.birthdate) }}
                      
                {{ form_label(registrationForm.licenseFfa) }}                
                <div class='text-danger'>            
                    {{ form_errors(registrationForm.licenseFfa) }}
                </div>
                {{ form_widget(registrationForm.licenseFfa) }}
                      
                {{ form_label(registrationForm.phone) }}
                <div class='text-danger'> 
                    {{ form_errors(registrationForm.phone) }}
                </div>                
                {{ form_widget(registrationForm.phone) }}

                {{ form_label(registrationForm.gender) }}                
                <div class='text-danger'>   
                    {{ form_errors(registrationForm.gender) }}
                </div> 
                {{ form_widget(registrationForm.gender) }}

                {{ form_label(registrationForm.poloSize) }}            
                <div class='text-danger'>                 
                    {{ form_errors(registrationForm.poloSize) }}                    
                </div>                 
                {{ form_widget(registrationForm.poloSize) }}

            </div> 
        </div>
       <div class="row justify-items-center">                 
            <div class="col text-center mb-4">                        
                <p> {{ form_row(registrationForm.agreeTerms) }} </p>
                <button class="btn btn btn-primary ms-4" type="submit">
                    Valider
                </button>
                Déjà inscrit(e) ? :<a href="{{ path('login') }}" class="btn btn-info btn-sm ms-1"> Me connecter</a>
            </div>                
            {{ form_end(registrationForm) }}
        </div>
    </section>    
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const checkbox = document.getElementById('registration_form_isCompetitor');
            const competitorFieldsContainer = document.getElementById('competitorFieldsContainer');

            const competitorFields = [
                'registration_form_licenseFfa',
                'registration_form_dateBirth',
                'registration_form_phone',
            ];

            /* ===============================
            1️⃣ Appliquer le style orange
            aux champs required existants
            (section Enregistrement)
            =============================== */
            function applyRequiredStyle() {
                document.querySelectorAll('input[required], select[required], textarea[required]')
                    .forEach(function (field) {
                        field.classList.add('required-field');
                    });
            }

            /* ===============================
            2️⃣ Gestion dynamique Concurrent
            =============================== */
            function updateFields(isChecked) {

                competitorFields.forEach(function (fieldId) {

                    const field = document.getElementById(fieldId);
                    if (!field) return;

                    const label = document.querySelector("label[for='" + fieldId + "']");

                    field.required = isChecked;

                    if (isChecked) {
                        field.classList.add('required-field');
                    } else {
                        field.classList.remove('required-field');
                    }

                    if (label) {
                        label.classList.toggle('required', isChecked);
                    }
                });

                if (competitorFieldsContainer) {
                    competitorFieldsContainer.style.display = isChecked ? 'block' : 'none';
                }
            }

            /* ===============================
            Initialisation
            =============================== */

            applyRequiredStyle(); // 👉 Pour Enregistrement

            if (checkbox) {
                checkbox.addEventListener('change', function () {
                    updateFields(this.checked);
                });

                updateFields(checkbox.checked);
            }

        });
    </script>

{% endblock %}
