{% extends 'base.html.twig' %}

{% block title %}Avions{% endblock %}

{% block body %}
     <style>
        input:invalid,
        select:invalid,
        textarea:invalid {
            outline: 2px solid red; 
        }

        input:required,
        select:required,
        textarea:required {
            outline: 1px solid orange; /* Applique un contour rouge à tous les champs "required" */

    </style>

    <div class='container-fluid'>
        <div class="row justify-content-center">
            <div class="col-12 col-md-11 col-lg-8">
                <section class="p-3 my-4">
                    <h4 class="mx-auto text-center fw-bold" style="width: 400px">Avions enregistrés</h4>                        

                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success mt-4">
                        {{ message }}
                        </div>   
                    {% endfor %}  

                    <div class="row mt-4">       
                        <!-- Aircraft -->                    
                        <div class="col-11 col-md-3 form-group ms-3 p-3">     
                            <div class="justify-content-center fw-bold p-3">
                                {% if aircrafts is not empty %}
                                    <ul>
                                        {% for aircraft in aircrafts %}
                                            <li>
                                                <a href="{{ path('edit_aircraft', { 'aircraft_id': aircraft.id }) }}"
                                                class="{{ aircraft.id == selectedAircraftId ? 'selected' : '' }}">
                                                    {{ aircraft.callsign }} 
                                                </a>

                                                <!-- Bouton de suppression -->
                                                <form action="{{ path('delete_aircraft', { 'id': aircraft.id }) }}" method="post" style="display:inline;">
                                                    <!-- Utilisation du token CSRF avec csrf_token() -->
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_aircraft_' ~ aircraft.id) }}">
                                                    <button type="submit" class="btn btn-link text-danger" title="Supprimer cet avion" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet avion ?');">
                                                        <i class="fas fa-trash-alt"></i> <!-- Icône de poubelle -->
                                                    </button>
                                                </form>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <p>Aucun avion d'enregistrer pour cet utilisateur.</p>
                                {% endif %}
                            </div>
                        </div>
                        <div class="col-11 col-md-6 form-group border rounded-4 border-primary ms-3 p-3">     
                            {% if form is not null %}
                                <div class="text-center mb-4">
                                    <h5><strong>Modifier un avion</strong></h5>
                                </div>
                                {{ form_start(form) }}
                                    <div class="mb-2">
                                        {{ form_label(form.callsign) }}
                                        <div class="required-field mt-2">
                                            {{ form_widget(form.callsign) }}
                                        </div>
                                        {{ form_errors(form.callsign) }}                                    
                                    </div>
                                    <div class="mb-3">
                                        {{ form_label(form.speed) }}
                                        <div class="required-field">
                                            {{ form_widget(form.speed) }}
                                        </div>
                                        {{ form_errors(form.speed) }}
                                    </div>
                                    <div class="mb-3"> 
                                        {{ form_row(form.flyingclub) }}   
                                    </div>                                         
                                    <div class="mb-3">            
                                        {{ form_row(form.brand) }}
                                    </div>
                                    <div class="mb-3">                       
                                        {{ form_row(form.type) }}
                                    </div>
                                    <div class="mb-3">            
                                        {{ form_row(form.oaci) }}
                                    </div>                   
                                    <div class="row justify-content-center my-4">
                                        <div class="col-10 text-center">
                                            <button class="btn btn-primary me-4" type="submit">Valider</button>
                                            <a href="{{ path('home') }}" class="btn btn-info btn-sm ms-4">Annuler</a>
                                        </div>
                                    </div>                               
                                {{ form_end(form) }}
                            {% endif %}                                  
                        </div>   
                        <p class="mt-4">Nota : l'enregistrement d'un nouvel avion est à réaliser lors d'une inscription.</p>
                                      
                    </div>
                </section>
            </div>
        </div>
    </div>
{% endblock %}