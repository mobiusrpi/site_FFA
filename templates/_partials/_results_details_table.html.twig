<table class="table table-bordered table-sm">
    <thead>
        <tr>
            <th class="text-center">Class.</th>
            <th class="text-center">Équipage</th>
            <th class="text-center" data-key="navigation">
                Nav
                <i class="fa-solid fa-sort sort-arrow ms-2" style="cursor:pointer;"></i>
            </th>
            {% if competition.typecompetition.id != 3 %}
                <th class="text-center" data-key="observation">
                    Obs
                    <i class="fa-solid fa-sort sort-arrow ms-2" style="cursor:pointer;"></i>
                </th>
            {% endif %}
                {% if competition.typecompetition.id == 2 %}
                    <th class="text-center" data-key="flightPlanning">
                        Théo                   
                        <i class="fa-solid fa-sort sort-arrow ms-2" style="cursor:pointer;"></i>
                    </th>
                {% else %}
                   <th class="text-center" data-key="landing">
                        Att                  
                        <i class="fa-solid fa-sort sort-arrow ms-2" style="cursor:pointer;"></i>
                    </th>
                {% endif %}
            <th class="text-center sort-column" data-key="total">
                <span class="fw-bold">
                    Total
                    <i class="fa-solid fa-sort sort-arrow ms-2"></i>
                </span>
            </th>
        </tr>
    </thead>
    <tbody>
    {% set lastScore = null %}
    {% set rank = 1 %}
    {% set actualRank = 0 %}

    {% for row in results %}
        {% set isDNS = row.dns == -1 %}
        {% set isDNF = row.dns == 1 %}
        {% set isOut = isDNS or isDNF %}
        {% set actualRank = actualRank + 1 %}

        {% if not isOut %}
            {% if row.total != lastScore %}
                {% set rank = actualRank %}
            {% endif %}
        {% endif %}

    <tr>
        <td class="text-center">
            {% if isOut %}
                –
            {% else %}
                {{ rank }}
            {% endif %}
        </td>

        <td>
            <small>
                {% if row.crew.pilot is defined %}
                    {{ row.crew.pilot.lastName }} {{ row.crew.pilot.firstName }}
                    <br>
                    {{ row.crew.navigator.lastName }} {{ row.crew.navigator.firstName }}
                {% else %}
                    {{ row.crew }}
                {% endif %}
            </small>
        </td>

        <td class="text-center">
           {% if row.dns != 0 %}
                --
            {% else %}
                {{ row.navigation }}
            {% endif %}
        </td>

        {% if competition.typecompetition.id != 3 %}
            <td class="text-center">
                {% if row.dns != 0 %}
                    --
                {% else %}
                    {{ row.observation }}
                {% endif %}
            </td>
        {% endif %}

        <td class="text-center">
            {% if row.dns != 0 %}
                --
            {% else %}
                {% if competition.typecompetition.id == 2 %}
                    {{ row.flightPlanning }}
                {% else %}
                    {{ row.landing }}
                {% endif %}
            {% endif %}
        </td>

        <td class="text-center">
            {% if row.dns == -1 %}
                DNS
            {% elseif row.dns == 1 %}
                DNF
            {% else %}
            {{ row.total }}
            {% endif %}
        </td>
    </tr>

    {% if not isOut %}
        {% set lastScore = row.total %}
    {% endif %}

    {% endfor %}
    </tbody>
</table>