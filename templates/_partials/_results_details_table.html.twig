<table class="table table-bordered table-sm">
    <thead>
        <tr>
            <th class="text-center">Class.</th>
            <th class="text-center">Équipage</th>
            <th class="text-center" data-key="navigation">
                Nav
                <i class="fa-solid fa-sort sort-arrow ms-2" style="cursor:pointer;"></i>
            </th>
            {% if competition.typecompetition.id != 3 %}
                <th class="text-center" data-key="observation">
                    Obs
                    <i class="fa-solid fa-sort sort-arrow ms-2" style="cursor:pointer;"></i>
                </th>
            {% endif %}
                {% if competition.typecompetition.id == 2 %}
                    <th class="text-center" data-key="flightPlanning">
                        Théo                   
                        <i class="fa-solid fa-sort sort-arrow ms-2" style="cursor:pointer;"></i>
                    </th>
                {% else %}
                   <th class="text-center" data-key="landing">
                        Att                  
                        <i class="fa-solid fa-sort sort-arrow ms-2" style="cursor:pointer;"></i>
                    </th>
                {% endif %}
            <th class="text-center sort-column" data-key="total">
                <span class="fw-bold">
                    Total
                    <i class="fa-solid fa-sort sort-arrow ms-2"></i>
                </span>
            </th>
        </tr>
    </thead>
    <tbody>
        {% set lastScore = null %}
        {% set rank = 1 %}
        {% set actualRank = 0 %}

        {% for row in results %}
            {% set actualRank = actualRank + 1 %}

            {# rang uniquement si pas DNS #}
            {% if not row.dns %}
                {% if row.total != lastScore %}
                    {% set rank = actualRank %}
                {% endif %}
            {% endif %}

            <tr>
                <td class="text-center">
                    {% if row.dns %}
                        –
                    {% else %}
                        {{ rank }}
                    {% endif %}
                </td>

                <td>
                    <small>
                        {% if row.crew.pilot is defined %}
                            {% if competition.typecompetition.id == 2 %}
                                {{ row.crew.pilot.lastName }} {{ row.crew.pilot.firstName }}
                            {% else %}
                                {{ row.crew.pilot.lastName }} {{ row.crew.pilot.firstName }}<br>
                                {{ row.crew.navigator.lastName }} {{ row.crew.navigator.firstName }}
                            {% endif %}
                        {% else %}
                            {{ row.crew }}
                        {% endif %}
                    </small>
                </td>

                {# Colonnes de pénalités #}
                {% if row.dns %}
                    <td class="text-center">--</td>
                {% else %}
                    <td class="text-center" data-value="{{ row.navigation ?? -1 }}">
                        {{ row.navigation }}
                    </td>
                {% endif %}

                {% if competition.typecompetition.id != 3 %}
                    {% if row.dns %}
                        <td class="text-center" data-value="-999">--</td>
                    {% else %}
                        <td class="text-center" data-value="{{ row.observation ?? -1 }}">
                            {{ row.observation }}
                        </td>
                    {% endif %}
                {% endif %}


                {% if row.dns %}
                    <td class="text-center" data-value="-999">--</td>
                {% else %}
                    {% if competition.typecompetition.id == 2 %}
                        <td class="text-center" data-value="{{ row.flightPlanning ?? -1 }}">
                            {{ row.flightPlanning }}
                        </td>
                    {% else %}
                        <td class="text-center" data-value="{{ row.landing ?? -1 }}">
                            {{ row.landing }}
                        </td>
                    {% endif %}
                {% endif %}


                {% if row.dns %}
                    <td class="text-center" data-value="-999"> DNS</td>
                {% else %}
                    <td class="text-center" data-value="{{ row.total ?? -1 }}">
                        {{ row.total }}
                    </td>
                {% endif %}
            </tr>

            {% if not row.dns %}
                {% set lastScore = row.total %}
            {% endif %}
        {% endfor %}
    </tbody>
</table>