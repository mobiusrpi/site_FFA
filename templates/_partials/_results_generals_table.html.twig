{% set competTypeId = competition.typecompetition.id %}
<table class="table table-bordered table-sm result-table w-100 mb-4">
    <thead>
        <tr>
            <th class="small-header class-col">Class.</th>
            <th class="text-center">
             <small>
                {% if competTypeId == 2 %}
                    Pilote
                {% else %}
                    Équipage
                {% endif %}
            </th>
            {% for testId, test in testNames %}
                {% set isNavOrAnrTest = test.label|slice(0, 3) in ['NAV', 'ANR'] %}
                    <th class="text-center sort-column" data-key="{{ testId }}">
                        {% if isNavOrAnrTest and test.hasDetail %}

                            <a href="{{ path('test_results_detail', { testId: testId }) }}"
                            class="text-primary text-decoration-underline fw-bold"
                            style="white-space: nowrap;"
                            title="Voir les détails de {{ test.label }}">

                                {{ test.label }}

                            </a>

                        {% else %}

                            <span class="fw-bold" style="white-space: nowrap;">
                                {{ test.label }}
                            </span>

                        {% endif %}

                        <i class="fa-solid fa-sort sort-arrow ms-2"
                        style="cursor:pointer;"></i>

                    </th>
            {% endfor %}
            <th class="text-center sort-column" data-key="total">
                <span class="fw-bold" style="white-space: nowrap;">
                    Total 
                </span>
                <i class="fa-solid fa-sort sort-arrow ms-2"></i>
            </th>
        </tr>
    </thead>
    <tbody>
        {% for rank, crewData in crews %}

            {% set hasOut = false %}
            {% for t in crewData.tests %}
                {% if t.dns is not same as(0) %}
                    {% set hasOut = true %}
                {% endif %}
            {% endfor %}

            <tr data-score="{{ crewData.total ?? -1 }}">

                <td class="text-center class-col">
                    {% if hasOut %}
                        --
                    {% else %}
                        {{ loop.index }}
                    {% endif %}
                </td>

                <td>
                    <small>
                        {{ crewData.crewName ?? '—' }}
                    </small>
                </td>

                {% for testKey, displayName in testNames %}

                    {% set result = crewData.tests[testKey] ?? null %}

                    <td class="text-center"
                        data-key="{{ testKey }}"
                        data-value="{{ result ? result.total : -1 }}">

                        {% if result is null %}
                            _
                        {% elseif result.dns == 1 %}
                            DNS
                        {% elseif result.dns == -1 %}
                            DNF
                        {% else %}
                            {{ result.total }}
                        {% endif %}

                    </td>

                {% endfor %}

                <td class="text-center"
                    data-key="total"
                    data-value="{{ hasOut ? -1 : crewData.total ?? -1 }}">

                    <strong>
                        {{ hasOut ? '--' : (crewData.total ?? '_') }}
                    </strong>

                </td>

            </tr>
        {% endfor %}
    </tbody>
</table>