<footer class="container-fluid bg-light border-top mt-4 py-3">

    {% set year = "now"|date("Y") %}

    {% if is_granted('IS_AUTHENTICATED_FULLY') %}

        {% set documentation =
            resources_by_category('documentation')
        %}

        {% set videos =
            resources_by_category('video')
        %}

        {% set softwares =
            resources_by_category('software')
        %}

    {% endif %}

    <div class="d-flex justify-content-between align-items-center">

        <div class="col-auto">
            <small class="text-muted">
                © {{ year }} https://sports.ff-aero.fr
            </small>
        </div>


        {% if is_granted('IS_AUTHENTICATED_FULLY') %}

            <div class="d-flex justify-content-end">

                {# ===================================================== #}
                {# WIKI SPORTS FFA                                       #}
                {# ===================================================== #}

                <div class="dropup me-2">

                    <a
                        class="btn btn-info btn-sm"
                        href="https://sports.ffa-aero.fr/docs/index.php/Accueil"
                        target="_blank"
                        rel="noopener">

                        🌐Aide - Wiki Sports

                    </a>

                </div>


                {# ===================================================== #}
                {# SOFTWARES                                              #}
                {# ===================================================== #}

                {% if softwares|length > 0 %}

                    <div class="dropup me-2">

                        <button
                            class="btn btn-info btn-sm dropdown-toggle"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">

                            Softwares

                        </button>

                        <ul class="dropdown-menu dropdown-menu-end">

                            {% for resource in softwares %}

                                {% if resource.filename %}

                                    <li>
                                        <a
                                            class="dropdown-item"
                                            href="{{ path(
                                                'resource_download',
                                                {'id': resource.id}
                                            ) }}">

                                            {{ resource.title }}

                                        </a>
                                    </li>

                                {% endif %}

                            {% endfor %}

                        </ul>

                    </div>

                {% endif %}


                {# ===================================================== #}
                {# DOCUMENTATION                                         #}
                {# ===================================================== #}

                {% if app.user.licenseFfa and documentation|length > 0 %}

                    <div class="dropup me-2">

                        <button
                            class="btn btn-info btn-sm dropdown-toggle"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">

                            Documentation

                        </button>

                        <ul class="dropdown-menu dropdown-menu-end">

                            {% for resource in documentation %}

                                <li>

                                    {% if resource.url %}

                                        <a
                                            class="dropdown-item"
                                            href="{{ resource.url }}"
                                            target="_blank"
                                            rel="noopener">

                                            {{ resource.title }}

                                        </a>

                                    {% elseif resource.filename %}

                                        <a
                                            class="dropdown-item"
                                            href="{{ path(
                                                'resource_download',
                                                {'id': resource.id}
                                            ) }}">

                                            {{ resource.title }}

                                        </a>

                                    {% endif %}

                                </li>

                            {% endfor %}

                        </ul>

                    </div>

                {% endif %}


                {# ===================================================== #}
                {# TUTORIELS VIDEOS                                      #}
                {# ===================================================== #}

                {% if videos|length > 0 %}

                    <div class="dropup me-2">

                        <button
                            class="btn btn-info btn-sm dropdown-toggle"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">

                            Tutoriels vidéos

                        </button>

                        <ul class="dropdown-menu dropdown-menu-end">

                            {% for resource in videos %}

                                {% if resource.url %}

                                    <li>
                                        <a
                                            class="dropdown-item"
                                            href="{{ resource.url }}"
                                            target="_blank"
                                            rel="noopener">

                                            {{ resource.title }}

                                        </a>
                                    </li>

                                {% endif %}

                            {% endfor %}

                        </ul>

                    </div>

                {% endif %}

            </div>

        {% endif %}

    </div>

</footer>