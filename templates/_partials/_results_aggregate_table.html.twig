{% set competTypeId = competition.typecompetition.id %}
<table class="table table-bordered table-sm mt-4 print-table">
    <thead>
        <tr>
            <th class="text-center sort-column" data-key="rank">Class.</th>
            <th>
            {% if competTypeId == 2 %}
                Pilote
            {% else %}
                Équipage
            {% endif %}</th>
            <th class="text-center sort-column" data-key="nav">NAV <i class="fa-solid fa-sort sort-arrow ms-2"></i></th>

            {% if competTypeId < 3 %}
                <th class="text-center sort-column" data-key="obs">OBS <i class="fa-solid fa-sort sort-arrow ms-2"></i></th>
            {% endif %}

            {% if competTypeId == 2 %}
                <th class="text-center sort-column" data-key="flightPlanning">Théo <i class="fa-solid fa-sort sort-arrow ms-2"></i></th>
            {% else %}
                <th class="text-center sort-column" data-key="att">ATT <i class="fa-solid fa-sort sort-arrow ms-2"></i></th>
            {% endif %}

            <th class="text-center sort-column" data-key="total">Total <i class="fa-solid fa-sort sort-arrow ms-2"></i></th>
        </tr>
    </thead>
    <tbody>
        {% for crewData in crews %}
            <tr data-score="{{ crewData.total ?? 0 }}">
                <td class="text-center">{{ loop.index }}</td>
                <td>
                    <small>
                        {{ crewData.crewName }}
                    </small>
                </td>
                <td class="text-center" data-value="{{ crewData.nav ?? 0 }}">
                    {{ crewData.nav is not null ? crewData.nav : '_' }}
                </td>

                {% if competTypeId < 3 %}
                    <td class="text-center" data-value="{{ crewData.obs ?? 0 }}">
                        {{ crewData.obs is not null ? crewData.obs : '_' }}
                    </td>
                {% endif %}
                {% if competTypeId == 2 %}
                    <td class="text-center" data-value="{{ crewData.flightPlanning ?? 0 }}">
                        {{ crewData.flightPlanning is not null ? crewData.flightPlanning : '_' }}
                    </td>
                {% else %}
                    <td class="text-center" data-value="{{ crewData.att ?? 0 }}">
                        {{ crewData.att is not null ? crewData.att : '_' }}
                    </td>
                {% endif %}

                <td class="text-center" data-value="{{ crewData.total ?? 0 }}">
                    <strong>{{ crewData.total is not null ? crewData.total : '_' }}</strong>
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>