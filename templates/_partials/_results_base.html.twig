{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}

    <style>
        /* ======================== */
        /* Styles pour impression    */
        /* ======================== */
        @media print {

            table.print-table td {
                padding: 3px 6px;
                line-height: 1.2;
                font-size: 14px;
            }

            .no-print {
                display: none !important;
            }

            .print-content {
                display: block;
                width: 100%;
            }

            .print-category {
                page-break-after: always;
            }

            .print-category:last-child {
                page-break-after: auto;
            }

            table {
                width: 100% !important;
                border-collapse: collapse;
            }

            th, td {
                border: 1px solid #000 !important;
                padding: 4px;
            }

            thead { 
                display: table-header-group; 
            }

            tfoot { 
                display: table-footer-group; 
            }

            .sort-arrow {
                display: none !important;
            }

            .print-header {
                display: flex;
                align-items: center;
                margin-bottom: 15px;
            }

            .print-logo {
                flex: 0 0 auto;
            }

            .print-title {
                flex: 1;
                text-align: center;
            }
        }

        /* ======================== */
        /* Écran                    */
        /* ======================== */
        @media screen {
            .print-content { display: none; }

            th {
                padding: 0.5rem 0.35rem;
                font-size: 1rem;
            }           
    
            td {
                padding: 0.15rem 0.25rem;
                font-size: 0.85rem;
            }

            th.class-col, td.class-col {
                width: 40px;
                max-width: 40px;

                text-align: center;
                white-space: nowrap;
            }

            th.class-col {               
                font-size: 0.85rem;
                padding-bottom: 0.35rem;
            }

            .results-category table th, .results-category table td {
                border: 1px solid silver;
            }

            .results-category table tr {
                border-bottom: 1.5px solid silver;
            }

            .results-container {
                display: flex;
                flex-wrap: wrap;
                gap: 0.5rem;
            }

            .results-category {
                flex: 1 1 350px;
                min-width: 250px;
                max-width: 100%;
                overflow-x: auto;
            }

            .results-category table {
                width: 100%;
                table-layout: fixed;
            }

            .small-header {
                font-size: 0.85rem;
                padding: 0.15rem 0.3rem;
            }
        }
    </style>
{% endblock %}

{% block body %}
    {% block result_content %}{% endblock %}
{% endblock %}