{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}

    <style>
        /* ======================== */
        /* Styles pour impression    */
        /* ======================== */
        @media print {

            table.print-table td {
                padding: 3px 6px;
                line-height: 1.2;
                font-size: 14px;
            }

            .no-print {
                display: none !important;
            }

            .print-content {
                display: block;
                width: 100%;
            }

            .print-category {
                page-break-after: always;
            }

            .print-category:last-child {
                page-break-after: auto;
            }

            table {
                width: 100% !important;
                border-collapse: collapse;
            }

            th, td {
                border: 1px solid #000 !important;
                padding: 4px;
            }

            thead { 
                display: table-header-group; 
            }

            tfoot { 
                display: table-footer-group; 
            }

            .sort-arrow {
                display: none !important;
            }

            .print-header {
                display: flex;
                align-items: center;
                margin-bottom: 15px;
            }

            .print-logo {
                flex: 0 0 auto;
            }

            .print-title {
                flex: 1;
                text-align: center;
            }
        }

        /* ======================== */
        /* Écran                    */
        /* ======================== */
        @media screen {
            .print-content { display: none; }

            th, td {
                padding: 0.15rem 0.25rem;
                font-size: 0.65rem;
            }

            th.class-col, td.class-col {
                width: 30px;
                max-width: 30px;
                padding: 0.1rem 0.15rem;
                font-size: 0.65rem;
                text-align: center;
                white-space: nowrap;
            }

            .results-category table th, .results-category table td {
                border: 1px solid black;
            }

            .results-category table tr {
                border-bottom: 1.5px solid black;
            }

            .results-container {
                display: flex;
                flex-wrap: wrap;
                gap: 0.5rem;
            }

            .results-category {
                flex: 1 1 350px;
                min-width: 250px;
                max-width: 100%;
                overflow-x: auto;
            }

            .results-category table {
                width: 100%;
                table-layout: fixed;
            }

            .small-header {
                font-size: 0.65rem;
                padding: 0.15rem 0.3rem;
            }
        }

        /* ======================== */
        /* Smartphone très compact   */
        /* ======================== */
        @media screen and (max-width: 576px) {
            .print-header {
                flex-direction: column !important;
                align-items: center !important;
                text-align: center !important;
            }

            .print-logo img {
                max-width: 30px !important;
                max-height: 30px !important;
                margin-bottom: 3px !important;
            }

            .print-title {
                font-size: 0.8rem !important;
            }

            th, td {
                font-size: 0.55rem !important;
                padding: 0.1rem 0.15rem !important;
            }

            th.class-col, td.class-col {
                width: 25px !important;
                max-width: 25px !important;
            }

            /* Scroll horizontal si table trop large */
            .results-category {
                overflow-x: auto;
            }
        }
    </style>
{% endblock %}

{% block body %}
    {% block result_content %}{% endblock %}
{% endblock %}