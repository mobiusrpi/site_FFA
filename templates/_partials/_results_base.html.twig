{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}

    <style>
        @media print {

            table.print-table td {
                padding: 3px 6px;
                line-height: 1.2;
                font-size: 14px;
            }

            .no-print {
                display: none !important;
            }

            .print-content {
                display: block;
                width: 100%;
            }

            .print-category {
                page-break-after: always;
            }

            .print-category:last-child {
                page-break-after: auto;
            }

            table {
                width: 100% !important;
                border-collapse: collapse;
            }

            th, td {
                border: 1px solid #000 !important;
                padding: 4px;
            }

            thead { 
                display: table-header-group; 
            }

            tfoot { 
                display: table-footer-group; 
            }

            .sort-arrow {
                display: none !important;
            }

            .print-header {
                display: flex;
                align-items: center;
                margin-bottom: 15px;
            }

            .print-logo {
                flex: 0 0 auto;
            }

            .print-title {
                flex: 1;
                text-align: center;
            }
        }

        @media screen {
            .print-content {
                display: none;
            }
            th, td {
                padding: 0.25rem 0.25rem;  /* réduit l’espace horizontal */
                font-size: 0.75rem;        /* small-header */
            }

            th.class-col,
            td.class-col {
                width: 40px;            /* largeur fixe adaptée à 1-2 chiffres */
                max-width: 40px;
                padding: 0.25rem 0.25rem;  /* réduire le padding */
                font-size: 0.75rem;         /* small-header */
                text-align: center;
                white-space: nowrap;
            }

            /* Bordures plus visibles pour toutes les cellules */
            .results-category table th,
            .results-category table td {
                border: 1.5px solid silver;   /* augmente l'épaisseur et rend noir */
            }

            /* Ligne horizontale renforcée si tu veux */
            .results-category table tr {
                border-bottom: 2px solid silver;  /* optionnel */
            }

            .results-container {
                display: flex;
                flex-wrap: wrap;       /* permet de passer à la ligne si ça déborde */
                gap: 1rem;             /* espace entre les tables */
            }

            .results-category {
                flex: 1 1 500px;       /* minimum 500px, sinon passe à la ligne */
                min-width: 300px;      /* ne devient pas trop étroit */
                max-width: 100%;       /* limite pour petits écrans */
                overflow-x: auto;      /* scroll horizontal si la table dépasse */
            }

            .results-category table {
                width: 100%;           /* occupe tout l'espace disponible */
                table-layout: fixed;   /* empêche le chevauchement des colonnes */
            }

            .small-header {
                font-size: 0.75rem;   /* ajuste la taille de la police */
                padding: 0.25rem 0.5rem; /* réduit aussi le padding vertical */
            }
       }
    /* Smartphone : empile logo et titre */
        @media screen and (max-width: 576px) {
            .print-header {
                flex-direction: column;
                align-items: center;
                text-align: center;
            }

            .print-logo img {
                max-width: 40px;
                max-height: 40px;
                margin-bottom: 5px;
            }

            .print-title {
                font-size: 0.9rem;
            }
        }
    </style>
{% endblock %}

{% block body %}
    {% block result_content %}{% endblock %}
{% endblock %}