<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{ subject }}</title>
    <style>
        body { font-family: Arial, sans-serif; line-height: 1.5; }
        .header { font-weight: bold; font-size: 1.2em; margin-bottom: 1em; }
        .results { margin-top: 1em; border-collapse: collapse; }
        .results th, .results td { border: 1px solid #ccc; padding: 5px 10px; }
        .results th { background-color: #f0f0f0; }
    </style>
</head>
<body>
    <p class="header">Bonjour {{ firstname }},</p>

    <p>Voici vos résultats pour la compétition <strong>{{ competitionName }}</strong> :</p>

    <table class="results">
        <tr>
            <th>Classement</th>
            <th>Score</th>
        </tr>
        <tr>
            <td>{{ ranking }}</td>
            <td>{{ score }}</td>
        </tr>
    </table>

    <p>Cordialement,<br/>L’équipe FFA</p>
</body>
</html>
