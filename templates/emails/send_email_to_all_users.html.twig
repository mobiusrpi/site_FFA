{# templates/admin/competitions/send_email_to_all_users.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}
    Envoyer un email
{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            Envoyer un email aux utilisateurs du site sports.ff-aero.fr
        </div>
        <div class="card-body">
            {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
                <div class="mb-3">
                    {{ form_label(form.subject, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.subject, {'attr': {'class': 'form-control'}}) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.message, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.message, {'attr': {'class': 'form-control', 'rows': 8}}) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.attachment, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.attachment, {'attr': {'class': 'form-control'}}) }}
                </div>
                 <div class="mb-3">
                    {{ form_label(form.replyTo, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.replyTo) }}
                </div>
                <button class="btn btn-success">
                    <i class="fas fa-paper-plane"></i> Envoyer
                </button>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
