{% extends 'base.html.twig' %}
{% block title %} 
  Accueil
{% endblock %}

{% block body %}
  <style>
    /* Mobile first (default) */
    .responsive-title {
      font-size: 1rem;
      font-weight: bold;
      line-height: 1.1;
      margin-bottom: 0.1rem;
    }

    .responsive-lead {
      font-size: 0.75rem;
      line-height: 1.1;
      margin-bottom: 0;
    }
    .banner-overlay {
      padding: 0.25rem;
    }

    /* Small screens (≥600px) */
    @media (min-width: 800px) {
      .responsive-title {
        font-size: 1.25rem;
      }

      .responsive-lead {
        font-size: 1rem;
      }
         
    .banner-overlay {
      padding: 0.5rem;
    }

    }
    /* Medium screens (≥900px) */
    @media (min-width: 900px) {
      .responsive-title {
        font-size: 1.75rem;
      }

      .responsive-lead {
        font-size: 1.2rem;
      }
         
      .banner-overlay {
        padding: 0.5rem;
      }

    }

    /* Large screens (≥1200px) */
    @media (min-width: 1200px) {
      .responsive-title {
        font-size: 2.0rem;
      }

      .responsive-lead {
        font-size: 1.5rem;
      }
    }     
    .banner-overlay {
      padding: 0.5rem;
    }
    .scroll-banner {
      overflow: hidden;
      position: relative;
      height: 3rem;
    }
    .banner-overlay .responsive-lead {
      color: blue;
  }

    .scroll-track {
      display: flex;
      gap: 3rem;
      white-space: nowrap;
      animation: scroll-left 20s linear infinite;
    }

    .scroll-item {
      flex-shrink: 0;
      white-space: nowrap;
    }

    @keyframes scroll-left {
      0% {
        transform: translateX(100%);
      }
      100% {
        transform: translateX(-100%);
      }

    }
  </style>
  <div class="position-relative">
    <img src="{{ asset('images/banner_top.jpg') }}" alt="FFA" class="img-fluid w-100" style="height: auto;">

    <div class="position-absolute top-0 start-0 w-100 text-center text-white banner-overlay">
      <h1 class="responsive-title">Sports de Navigation aérienne :</h1>
      <h4 class="responsive-lead text-navy">Rallye - Pilotage de précision – Course de Navigation aérienne (ANR)</h4>
    </div>
  </div>
  {% if nextCompetitions is not empty %}
    <div class="scroll-banner bg-dark text-white py-2">
      <div class="scroll-track">
      Prochaines compétitions : 
        {% for comp in nextCompetitions %}
          <div class="scroll-item me-5">
            📅 <strong>{{ comp.location ?? 'Lieu inconnu' }}</strong> – {{ comp.typecompetition.typecomp ?? '' }} – 
            ({{ comp.startDate|format_datetime(locale='fr', pattern='dd MMMM') }}) 
          </div>
        {% endfor %}
      </div>
    </div>
 
  {% endif %}
  {% set currentYear = selectedYear %}
  {% set pastYears = years|filter(y => y != currentYear) %}
    
  <div class="container-fluid mt-4 px-3">
    <div class="row">
      {# Left column: Filter by year #}
      <div class="col-md-3 mb-4">
        <div class="bg-light p-3 rounded shadow-sm">
          <h5 class="mb-4">Résultats</h5>
          <strong>Année</strong>

          <div class="mt-2 mb-3">
            <a href="{{ path('home', { year: currentYear }) }}"
              class="btn btn-sm btn-primary w-100">
              {{ currentYear }}
            </a>
          </div>
          <strong>Archives</strong>
          <select class="form-select form-select-sm mt-2"
                  onchange="if (this.value) window.location.href = this.value;">
            <option value="">Choisir une année</option>

            {% for year in pastYears %}
              <option value="{{ path('home', { year: year }) }}">
                {{ year }}
              </option>
            {% endfor %}
          </select>

          {% if live is not empty %}
            <div class="mt-4">
              <strong>Résultats en direct</strong>
              {% for test in live %}
                <div class="mt-2">
                  <a href="{{ path('public_results_kiosk', { testId: test.id }) }}"
                    class="btn btn-sm {{ test ? 'btn-warning' : 'btn-outline-warning' }}  w-100 text-centered">
                    {{ test.name }}
                  </a>            
                </div>
              {% endfor %}
            </div>
          {% endif %}        
        </div>
      </div>
      {% set medals = ['🥇', '🥈', '🥉'] %} 

      {# Right column: Competition cards #}
      <div class="col-md-9 ">        

        {% if groupedCompetitions %}
          {% for item in groupedCompetitions %}
            {% set competition = item.competition %}
            <div class="card mb-4 shadow-sm">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                  <h5 class="mb-0">{{ competition.name }}</h5>
                  <div class="text-centered">
                    <strong>{{ competition.typecompetition.typecomp }}</strong>
                  </div>
                  <div class="text-end">
                    <small class="text-muted">{{ competition.startDate|format_datetime(locale='fr',pattern='dd MMMM y') }}</small><br>
                  </div>
                </div>

                <div class="row">
                  <div class="col-md-6">
                    <h6><strong>Elite</strong></h6>
                    <ol class="ps-3">
                      {% set eliteResults = item.elite|filter(r => r.dns == 0) %}
                      {% for result in eliteResults|slice(0, 3) %}
                        <li>
                          {{ loop.index == 1 ? '🥇' : (loop.index == 2 ? '🥈' : (loop.index == 3 ? '🥉' : loop.index) ) }}
                          {{ result.crew }} – {{ result.total }} pts
                        </li>
                      {% else %}
                        <li class="text-muted">Aucun résultat</li>
                      {% endfor %}
                    </ol>
                  </div>
                  <div class="col-md-6">
                    <h6><strong>Honneur</strong></h6>
                    <ol class="ps-3">
                      {% set honneurResults = item.honneur|filter(r => r.dns == 0) %}

                      {% for result in honneurResults|slice(0, 3) %}
                        <li>
                          {{ loop.index == 1 ? '🥇' : (loop.index == 2 ? '🥈' : (loop.index == 3 ? '🥉' : '') ) }}
                          {{ result.crew }} – {{ result.total }} pts
                        </li>
                      {% else %}
                        <li class="text-muted">Aucun résultat</li>
                      {% endfor %}
                    </ol>
                  </div>
                </div>

                <a href="{{ path('test_results_general', { id: competition.id }) }}"
                  class="btn btn-sm btn-outline-primary px-2 py-1 small">
                  Résultats complets
                </a>          
                <a href="{{ path('test_results_aggregate', { id: competition.id }) }}"
                  class="btn btn-sm btn-outline-primary px-2 py-1 small">
                  Classement par épreuve
                </a>          

              </div>
            </div>
          {% endfor %}
        {% else %}
        <div class="alert alert-info">
            Il n'y a pas encore de résultats pour cette année.<br>
            {% if pastYears|length > 0 %}
                <a href="{{ path('home', { year: pastYears|first }) }}" class="btn btn-sm btn-outline-primary mt-2">
                    Voir les résultats de l'année précédente ({{ pastYears|first }})
                </a>
            {% endif %}
        </div>
        {% endif %}
      </div>
    </div>
  </div>
{% endblock %}