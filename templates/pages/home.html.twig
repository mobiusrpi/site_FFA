{% extends 'base.html.twig' %}
{% block title %} 
  Accueil
{% endblock %}

{% block body %}
  <style>
    /* Mobile first (default) */
    .responsive-title {
      font-size: 1rem;
      font-weight: bold;
    }

    .responsive-lead {
      font-size: 0.75rem;
    }
    
    .banner-overlay {
      padding: 0.25rem;
    }

    /* Small screens (≥600px) */
    @media (min-width: 800px) {
      .responsive-title {
        font-size: 1.25rem;
      }

      .responsive-lead {
        font-size: 1rem;
      }
         
    .banner-overlay {
      padding: 0.5rem;
    }

    }
    /* Medium screens (≥900px) */
    @media (min-width: 900px) {
      .responsive-title {
        font-size: 1.75rem;
      }

      .responsive-lead {
        font-size: 1.2rem;
      }
         
      .banner-overlay {
        padding: 0.5rem;
      }

    }

    /* Large screens (≥1200px) */
    @media (min-width: 1200px) {
      .responsive-title {
        font-size: 2.0rem;
      }

      .responsive-lead {
        font-size: 1.5rem;
      }
    }     
    .banner-overlay {
      padding: 0.5rem;
    }
    .scroll-banner {
      overflow: hidden;
      position: relative;
      height: 3rem;
    }

    .scroll-track {
      display: flex;
      gap: 3rem;
      white-space: nowrap;
      animation: scroll-left 20s linear infinite;
    }

    .scroll-item {
      flex-shrink: 0;
      white-space: nowrap;
    }

    @keyframes scroll-left {
      0% {
        transform: translateX(100%);
      }
      100% {
        transform: translateX(-100%);
      }

    }
  </style>
  <div class="position-relative">
    <img src="{{ asset('images/banner_top.jpg') }}" alt="FFA" class="img-fluid w-100" style="height: auto;">

    <div class="position-absolute top-0 start-0 w-100 text-center text-white banner-overlay">
      <h1 class="responsive-title">Sports aériens : Rallye - Pilotage de précision - ANR</h1>
    </div>
  </div>
  {% if nextCompetitions is not empty %}
    <div class="scroll-banner bg-dark text-white py-2">
      <div class="scroll-track">
      Prochaines compétitions : 
        {% for comp in nextCompetitions %}
          <div class="scroll-item me-5">
            📅 <strong>{{ comp.location ?? 'Lieu inconnu' }}</strong> – {{ comp.typecompetition.typecomp ?? '' }} – 
            ({{ comp.startDate|format_datetime(locale='fr', pattern='dd MMMM') }}) 
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

    
  <div class='container mt-4'>
    <div class="row">
      {# Left column: Filter by year #}
      <div class="col-md-2 mb-4">
        <div class="bg-light p-3 rounded shadow-sm">
          <h5 class="mb-4">Résultats</h5>
          <strong>Année</strong>
          <div class="mt-2">
            {% for year in years %}
              <a href="{{ path('home', { year: year }) }}"
                class="btn btn-sm {{ year == selectedYear ? 'btn-primary' : 'btn-outline-primary' }}  mb-2 w-100 text-centered">
                {{ year }}
              </a>
            {% endfor %}
          </div>
          {% if live is not empty %}
          <div class="mt-4">
            <strong>Direct</strong>
              {% for test in live %}
                <div class="mt-2">
                  <a href="{{ path('public_results_kiosk', { testId: test.id }) }}"
                    class="btn btn-sm {{ test ? 'btn-warning' : 'btn-outline-warning' }}  w-100 text-centered">
                    {{ test.name }}
                  </a>            
                </div>
              {% endfor %}
            </div>
          {% endif %}        
        </div>
      </div>
      {% set medals = ['🥇', '🥈', '🥉'] %} 

      {# Right column: Competition cards #}
      <div class="col-md-10 ">
        {% for item in groupedCompetitions %}
          {% set competition = item.competition %}
          <div class="card mb-4 shadow-sm">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">{{ competition.name }}</h5>
                <div class="text-centered">
                  <strong>{{ competition.typecompetition.typecomp }}</strong>
                </div>
                <div class="text-end">
                  <small class="text-muted">{{ competition.startDate|format_datetime(locale='fr',pattern='dd MMMM y') }}</small><br>
                </div>
              </div>

              <div class="row">
                <div class="col-md-6">
                  <h6>Elite</h6>
                  <ol class="ps-3">
                    {% for result in item.elite|slice(0, 3) %}
                      <li>
                        {{ loop.index == 1 ? '🥇' : (loop.index == 2 ? '🥈' : (loop.index == 3 ? '🥉' : loop.index) ) }}
                        {% set pilot = attribute(result.crew, 'pilot') ?? null %}
                        {% if pilot %}
                          {{result.crew.pilot.lastname }} {{result.crew.pilot.firstname }} / {{ result.crew.navigator.lastname }} {{ result.crew.navigator.firstname }}
                        {% else %}
                          {{ result.crew }}
                        {% endif %} – {{ result.total }} pts
                      </li>
                    {% else %}
                      <li class="text-muted">Aucun résultat</li>
                    {% endfor %}
                  </ol>
                </div>
                <div class="col-md-6">
                  <h6>Honneur</h6>
                  <ol class="ps-3">
                    {% for result in item.honneur|slice(0, 3) %}
                      <li>
                        {{ loop.index == 1 ? '🥇' : (loop.index == 2 ? '🥈' : (loop.index == 3 ? '🥉' : '') ) }}
                        {{ result.crew }} – {{ result.total }} pts
                      </li>
                    {% else %}
                      <li class="text-muted">Aucun résultat</li>
                    {% endfor %}
                  </ol>
                </div>
              </div>

              <a href="{{ path('test_results_general', { id: competition.id }) }}"
                class="btn btn-sm btn-outline-primary px-2 py-1 small">
                Résultats complets
              </a>          

            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
{% endblock %}