{% extends 'base.html.twig' %}

{% block title %}Liste des compétitions{% endblock %}

{% block body %} 
    <style>
        .min-width-70 {
            min-width: 70px;
        }
    </style>
    <div class="container mt-4">
        <h3 class='mx-auto text-center fw-bold'>Inscription aux compétitions de {{ date('now')|date ('Y') }}</h3>

        {% for message in app.flashes('success') %}
          <div class="alert alert-success mt-4">
            {{message}}
          </div> 
        {% endfor %}
        {% set currentYear = 'now'|date('Y') %}
        {% set today = 'now'|date('Y-m-d') %}
        {% set endOfYear = currentYear ~ '-12-31' %}

        {% if competition_list is empty %}
        <div class="mt-4">
            {% if today > endOfYear %}
            <p>Les compétitions pour {{ currentYear }} sont terminées.</p>
            {% else %}
            <p>Aucune compétition inscrite pour {{ currentYear }}.</p>
            {% endif %}
        </div>
        {% endif %}


        <div class="row">
            {% for compet in competition_list %}
                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 mt-4">
                    <div class="card mb-3 shadow-sm border border-info">
                        <div class="card-body">
                            <h5 class="card-title">{{ compet.name }}</h5>
                            <p class="card-text mb-1"><strong>Type:</strong> {{ compet.typecompetition.typeComp }}</p>
                            <p class="card-text mb-1"><strong>Lieu:</strong> {{ compet.location }}</p>
                            <p class="card-text mb-1"><strong>Inscription:</strong> 
                                {% if compet.startRegistration|date('Y-m-d') != compet.endRegistration|date('Y-m-d') %} 
                                    {{ compet.startRegistration|format_datetime(locale='fr', pattern='dd MMMM') }} au 
                                {% endif %}                                                         
                                <span class="{{ compet.endRegistration|date('Y-m-d') < date('now')|date('Y-m-d') ? 'text-danger' : '' }}">
                                    {{ compet.endRegistration|format_datetime(locale='fr', pattern='dd MMMM YYYY') }}
                                </span>
                            </p>
                            <p class="card-text mb-2"><strong>Compétition:</strong> 
                                {% if compet.startDate|date('Y-m-d') != compet.endDate|date('Y-m-d') %}
                                    {{ compet.startDate|format_datetime(locale='fr', pattern='dd MMMM') }} au
                                {% endif %}
                                {{ compet.endDate|format_datetime(locale='fr', pattern='dd MMMM YYYY') }}
                            </p> 

                            {% if is_granted('ROLE_USER') %}
                                <p><strong>Inscrits par catégorie:</strong></p>
                                <ul>
                                    {% set counts = inscriptionsByCompetition[compet.id] ?? [] %}
                                    {% for item in counts %}
                                        {% if ( (compet.eliteMax | default(0)) + (compet.honorMax | default(0)) ) != 0 %}                                      
                                            <li>
                                                <a href="{{ path('competition_category_crews_list', {
                                                    id: compet.id,
                                                    cat: item.category.getLabel()
                                                }) }}"> {{ item.category.getLabel() }}</a>
                                                {% if item.category.getLabel() == 'Elite'  %}
                                                    (maxi, {{ compet.eliteMax }}) : {{ item.nb }}
                                                {% else %}
                                                    (maxi, {{ compet.honorMax }}) : {{ item.nb }}
                                                {% endif %}
                                            </li>
                                        {% else %}
                                            <li>
                                                <a href="{{ path('competition_category_crews_list', {
                                                    id: compet.id,
                                                    cat: item.category.getLabel()
                                                }) }}">
                                                    {{ item.category.getLabel() }} : {{ item.nb }}
                                                </a>
                                            </li>
                                        {% endif %}
                                    {% else %}
                                        <li>Aucun inscrit</li>
                                    {% endfor %}
                                </ul>
                                <div class="d-flex gap-2 justify-content-center gap-2 mt-3"> 
                                  <div style="text-align: center; margin: 20px 0;">
                                      {% if compet.startRegistration|date('Y-m-d') <= date('now')|date('Y-m-d')
                                            and date('now')|date('Y-m-d') <= compet.endRegistration|date('Y-m-d') %}
                                          <form action="{{ path('crews_registration', {'competId': compet.id}) }}" method="get" style="display: inline;">
                                              <button type="submit"
                                                  class="btn btn-outline-success btn-sm text-center mt-2"
                                                  title="Modifier">
                                                <i class="fa-solid fa-pen-to-square"></i>Inscription
                                              </button>       
                                              {% if compet.programmePdf %}  
                                                  <div class="mt-2">                                       
                                                      <a href="/uploads/programmes/{{ compet.programmePdf }}" target="_blank" style="color: #0cf; font-size: 1em;">
                                                          📄 Consulter le programme
                                                      </a>            
                                                  </div> 
                                              {% endif %}
                                          </form>                                
                                      {% elseif compet.endRegistration|date('Y-m-d') < date('now')|date('Y-m-d') %}
                                          <button class="btn btn-outline-danger btn-sm" disabled>
                                            <i class="fa-solid fa-clock me-1"></i>Hors délai
                                          </button>
                                      {% else %}
                                          <button class="btn btn-outline-warning btn-sm" disabled>
                                            <i class="fa-solid fa-hourglass-half me-1"></i>En attente
                                          </button>
                                      {% endif %}                              
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </div>                  
                </div>
            {% endfor %}
        </div>
    <div>          
    {% if is_granted('IS_AUTHENTICATED_FULLY') %}
      {% else %}
      <h6 class="container mt-4">
        <p class="fw-bold">Veuillez-vous connecter pour vous inscrire</p>
      </h6>       
    {% endif %}
  {% endblock %}
