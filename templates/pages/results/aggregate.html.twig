{% extends 'base.html.twig' %}

{% block title %}          
    Classement
{% endblock %}

{% block body %}
    <div class="container-fluid mt-4"> 
        <div class="row align-items-center mb-3 no-print">
            <div class="col-12 col-md-8 mx-auto">
                <h5 class="text-center">
                    <strong>Compétition {{ competition.name }}</strong><br>
                    {{ competition.startDate|format_datetime(locale='fr', pattern='dd MMMM') }}
                    au {{ competition.endDate|format_datetime(locale='fr', pattern='dd MMMM YYYY') }}<br>
                    <br>
                    <strong>Résultats par type d'épreuve</strong>               
                </h5>

            </div>
            <div class="col-12 col-md-4 text-center text-md-end mt-2 mt-md-0">
                <button onclick="window.print()">🖨️ Imprimer</button>
                <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
                    <i class="fa-solid fa-arrow-left me-1"></i> Retour
                </a>
            </div>
        </div>

        <div class="row g-0">
            {% for category, crews in scoreByCategory %}
                <div class="col-12 col-lg-6 mt-4 page-break">
                    <h5 class="text-center">
                        <strong>
                            Catégorie {{ category }}
                        </strong>
                    </h5>

                    <div class="table-responsive">
                        <table class="table table-bordered table-sm mt-4 print-table">
                            <thead>
                                <tr>
                                    <th class="text-center sort-column" data-key="rank">Class.</th>
                                    <th>Équipage / Pilote</th>
                                    <th class="text-center sort-column" data-key="nav">NAV <i class="fa-solid fa-sort sort-arrow ms-2"></i></th>

                                    {% if competition.typecompetition.id < 3 %}
                                        <th class="text-center sort-column" data-key="obs">OBS <i class="fa-solid fa-sort sort-arrow ms-2"></i></th>
                                    {% endif %}

                                    {% if competition.typecompetition.id == 2 %}
                                        <th class="text-center sort-column" data-key="flightPlanning">Théorique <i class="fa-solid fa-sort sort-arrow ms-2"></i></th>
                                        <th class="text-center sort-column" data-key="att">ATT <i class="fa-solid fa-sort sort-arrow ms-2"></i></th>
                                    {% else %}
                                        <th class="text-center sort-column" data-key="att">ATT <i class="fa-solid fa-sort sort-arrow ms-2"></i></th>
                                    {% endif %}

                                    <th class="text-center sort-column" data-key="total">Total <i class="fa-solid fa-sort sort-arrow ms-2"></i></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for crewData in crews %}
                                    <tr data-score="{{ crewData.total ?? 0 }}">
                                        <td class="text-center">{{ loop.index }}</td>
                                        <td>{{ crewData.crew }}</td>
                                        <td class="text-center" data-value="{{ crewData.nav ?? 0 }}">{{ crewData.nav is not null ? crewData.nav : '_' }}</td>

                                        {% if competition.typecompetition.id < 3 %}
                                            <td class="text-center" data-value="{{ crewData.obs ?? 0 }}">{{ crewData.obs is not null ? crewData.obs : '_' }}</td>
                                        {% endif %}

                                        {% if competition.typecompetition.id == 2 %}
                                            <td class="text-center" data-value="{{ crewData.flightPlanning ?? 0 }}">{{ crewData.flightPlanning is not null ? crewData.flightPlanning : '_' }}</td>
                                            <td class="text-center" data-value="{{ crewData.att ?? 0 }}">{{ crewData.att is not null ? crewData.att : '_' }}</td>
                                        {% else %}
                                            <td class="text-center" data-value="{{ crewData.att ?? 0 }}">{{ crewData.att is not null ? crewData.att : '_' }}</td>
                                        {% endif %}

                                        <td class="text-center" data-value="{{ crewData.total ?? 0 }}"><strong>{{ crewData.total is not null ? crewData.total : '_' }}</strong></td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    {# Script de tri #}
    <script>
        document.querySelectorAll('.table').forEach(table => {
            const headers = table.querySelectorAll('.sort-column');

            headers.forEach((header, index) => {
                const icon = header.querySelector('.sort-arrow');
                let ascending = true;
                const key = header.dataset.key;

                if (icon && key) {
                    icon.addEventListener('click', () => {
                        const tbody = table.querySelector('tbody');
                        const rows = Array.from(tbody.querySelectorAll('tr'));

                        rows.sort((a, b) => {
                            let aVal = 0;
                            let bVal = 0;

                            if (key === 'rank') {
                                aVal = parseInt(a.children[0].textContent) || 0;
                                bVal = parseInt(b.children[0].textContent) || 0;
                            } else {
                                const cellIndex = Array.from(header.parentNode.children).indexOf(header);
                                aVal = parseFloat(a.children[cellIndex].dataset.value) || 0;
                                bVal = parseFloat(b.children[cellIndex].dataset.value) || 0;
                            }

                            return ascending ? aVal - bVal : bVal - aVal;
                        });

                        ascending = !ascending;

                        rows.forEach(row => tbody.appendChild(row));

                        // Mise à jour des icônes
                        headers.forEach(h => {
                            const i = h.querySelector('.sort-arrow');
                            if (i) { i.classList.remove('fa-sort-up', 'fa-sort-down'); i.classList.add('fa-sort'); }
                        });
                        icon.classList.remove('fa-sort');
                        icon.classList.add(ascending ? 'fa-sort-up' : 'fa-sort-down');

                        // Recalcul du classement
                        rows.forEach((row, i) => {
                            row.children[0].textContent = i + 1;
                        });
                    });
                }
            });
        });
    </script>

{% endblock %}