{% extends 'base.html.twig' %}

{% block title %}          
    Classement
{% endblock %}

{% block body %}
    <div class="container-fluid mt-4">
        <div class="row align-items-center mb-3 no-print">
            <div class="col-12 col-md-8 mx-auto">
                <h5 class="text-center">
                    <strong>Compétition {{ competition.name }}</strong><br>
                    {{ competition.startDate|format_datetime(locale='fr', pattern='dd MMMM') }}
                    au {{ competition.endDate|format_datetime(locale='fr', pattern='dd MMMM YYYY') }}
                </h5>
            </div>
            <div class="col-12 col-md-4 text-center text-md-end mt-2 mt-md-0">
                <button onclick="window.print()">🖨️ Imprimer</button>
                <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
                    <i class="fa-solid fa-arrow-left me-1"></i> Retour
                </a>
            </div>
        </div>

        <div class="row g-0">
            {% for category, crews in scoreByCategory %}
                <div class="col-12 col-lg-6 mt-4 page-break">
                    <h5 class="text-center">
                        <strong>
                            Catégorie
                            <a href="{{ path('test_results_per_category',{ id: competition.id, category: category }) }}"
                                class="text-primary text-decoration-underline fw-bold"
                                style="white-space: nowrap;"
                                title="Voir par categorie {{ category }}">
                                {{ category }}
                            </a>
                        </strong>
                    </h5>

                    <div class="table-responsive">
                        <table class="table table-bordered table-sm mt-4 print-table">
                            <thead>
                                <tr>
                                    <th>Class.</th>
                                    <th>
                                        {% if competition.typecompetition.id == 2 %}
                                            Pilote
                                        {% else %}
                                            Équipage
                                        {% endif %}
                                    </th>
                                    <th class="text-center sort-column" data-key="nav">
                                        <span class="fw-bold" style="white-space: nowrap;">
                                            NAV <i class="fa-solid fa-sort sort-arrow ms-2" style="cursor:pointer;"></i>
                                        </span>
                                    </th>
                                    <th class="text-center sort-column" data-key="obs">
                                        <span class="fw-bold" style="white-space: nowrap;">
                                            OBS <i class="fa-solid fa-sort sort-arrow ms-2" style="cursor:pointer;"></i>
                                        </span>
                                    </th>
                                    <th class="text-center sort-column" data-key="att">
                                        <span class="fw-bold" style="white-space: nowrap;">
                                            {% if competition.typecompetition.id == 2 %}
                                                Théorique
                                            {% else %}
                                                ATT
                                            {% endif %}
                                            <i class="fa-solid fa-sort sort-arrow ms-2" style="cursor:pointer;"></i>
                                        </span>
                                    </th>
                                    {% if competition.typecompetition.id == 2 %}
                                        <th class="text-center sort-column" data-key="att">
                                            <span class="fw-bold" style="white-space: nowrap;">
                                                ATT <i class="fa-solid fa-sort sort-arrow ms-2" style="cursor:pointer;"></i>
                                            </span>
                                        </th>
                                    {% endif %}
                                    <th class="text-center sort-column" data-key="total">
                                        <span class="fw-bold" style="white-space: nowrap;">
                                            Total <i class="fa-solid fa-sort sort-arrow ms-2"></i>
                                        </span>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for crewData in crews %}
                                    <tr data-score="{{ crewData.total ?? 0 }}">
                                        <td class="text-center">{{ loop.index }}</td>
                                        <td>
                                            {% if crewData.crew is iterable %}
                                                {{ crewData.crew.fullName ?? crewData.crew.name ?? '—' }}
                                            {% else %}
                                                {{ crewData.crew }}
                                            {% endif %}
                                        </td>
                                        
                                        {# NAV #}
                                        <td class="text-center" data-key="nav" data-value="{{ crewData.nav is not null ? crewData.nav : -1 }}">
                                            {{ crewData.nav is not null ? crewData.nav : '_' }}
                                        </td>

                                        {# OBS #}
                                        <td class="text-center" data-key="obs" data-value="{{ crewData.obs is not null ? crewData.obs : -1 }}">
                                            {{ crewData.obs is not null ? crewData.obs : '_' }}
                                        </td>

                                        {# ATT / FlightPlanning #}
                                        <td class="text-center" data-key="att" data-value="{{ crewData.att is not null ? crewData.att : -1 }}">
                                            {{ crewData.att is not null ? crewData.att : '_' }}
                                        </td>
                                        {% if competition.typecompetition.id == 2 %}
                                            <td class="text-center">{{ crewData.att is not null ? crewData.att : '_' }}</td>
                                        {% endif %}  
                                        {# Total #}
                                        <td class="text-center" data-key="total" data-value="{{ crewData.total is not null ? crewData.total : -1 }}">
                                            <strong>{{ crewData.total is not null ? crewData.total : '_' }}</strong>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>

                        </table>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    {# Script de tri pour toutes les colonnes #}
    <script>
document.querySelectorAll('.table').forEach(table => {
    const tbody = table.querySelector('tbody');
    const rows = Array.from(tbody.querySelectorAll('tr'));

    // Tri initial croissant sur 'total'
    rows.sort((a, b) => {
        const aVal = parseFloat(a.querySelector('td[data-key="total"]')?.dataset.value ?? -1);
        const bVal = parseFloat(b.querySelector('td[data-key="total"]')?.dataset.value ?? -1);
        return aVal - bVal;
    });

    // Réinsérer les lignes triées
    rows.forEach(row => tbody.appendChild(row));

    // Ensuite, ton code existant pour les headers et clic sur flèches
    const headers = table.querySelectorAll('.sort-column');
    headers.forEach(header => {
        const icon = header.querySelector('.sort-arrow');
        let ascending = true;
        const key = header.dataset.key;

        if (icon && key) {
            icon.addEventListener('click', (event) => {
                event.preventDefault();
                event.stopPropagation();

                const rows = Array.from(tbody.querySelectorAll('tr'));

                rows.sort((a, b) => {
                    const aCell = a.querySelector(`td[data-key="${key}"]`);
                    const bCell = b.querySelector(`td[data-key="${key}"]`);
                    const aVal = parseFloat(aCell?.dataset.value ?? -1);
                    const bVal = parseFloat(bCell?.dataset.value ?? -1);
                    return ascending ? aVal - bVal : bVal - aVal;
                });

                ascending = !ascending;
                rows.forEach(row => tbody.appendChild(row));

                // Mettre à jour les icônes
                headers.forEach(h => {
                    const i = h.querySelector('.sort-arrow');
                    if (i) {
                        i.classList.remove('fa-sort-up', 'fa-sort-down');
                        i.classList.add('fa-sort');
                    }
                });
                icon.classList.remove('fa-sort');
                icon.classList.add(ascending ? 'fa-sort-up' : 'fa-sort-down');

                // Recalculer les rangs si nécessaire
                if (key === 'total') {
                    let previousScore = null;
                    let rank = 0;
                    let displayRank = 0;
                    rows.forEach((row) => {
                        const score = parseFloat(row.dataset.score ?? 0);
                        rank++;
                        if (score !== previousScore) displayRank = rank;
                        row.children[0].textContent = displayRank;
                        previousScore = score;
                    });
                } else {
                    rows.forEach((row, i) => row.children[0].textContent = i + 1);
                }
            });
        }
    });
});

    </script>

{% endblock %}