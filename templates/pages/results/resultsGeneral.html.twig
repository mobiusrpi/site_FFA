{% extends 'base.html.twig' %}

{% block title %}          
    Classement
{% endblock %}

{% block body %}
  <style>
        @media print {
            .page-break {
                page-break-after: always;
            }
        }
        @media print {
            .no-print {
                display: none !important;
            }
            .print-only {
                display: block !important;
            }
        }   
        @media screen {
            .print-only {
                display: none;
            }
        }
        /* Règles générales */
        table.print-table {
            border-collapse: collapse;
            width: 100%;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        /* Bordures plus foncées / épaisses pour impression */
        @media print {
            table.print-table th,
            table.print-table td {
                border: 2px solid #000 !important;   /* 2px = plus épais */
                padding: 4px;                        /* ajuster l'espacement */
                background-color: white !important;  /* garantir fond blanc si besoin */
            }
            table.print-table thead th {
                background-color: silver !important; /* si tu veux en-tête gris */
            }
            /* cacher éléments non imprimables */
            .no-print { 
                display: none !important; 
            }
        }

        .sort-column {
            cursor: pointer;
            user-select: none;
        }
        .sort-column:hover {
            background-color:rgb(243, 158, 158);
        }
        .sort-arrow {
            color: #999 !important;
            text-decoration: none !important;
            pointer-events: auto;
        }

        .sort-arrow:hover {
            color: #000 !important;       
        }
    </style>
    <div class="container-fluid mt-4">
        <div class="row align-items-center mb-3 no-print">
            <div class="col-12 col-md-8 mx-auto">
                <h5 class="text-center">
                    <strong>Compétition {{ competition.name }}</strong></br>
                    {{ competition.startDate|format_datetime(locale='fr', pattern='dd MMMM') }}
                    au {{ competition.endDate|format_datetime(locale='fr', pattern='dd MMMM YYYY') }}
                </h5>
            </div>
            <div class="col-12 col-md-4 text-center text-md-end mt-2 mt-md-0">
                <button onclick="window.print()">🖨️ Imprimer</button>
                <a  href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
                    <i class="fa-solid fa-arrow-left me-1"></i> Retour
                </a>
            </div>
        </div>    
        <div class="row g-0"> 
            {% for category, crews in scoreByCategory %}
                <div class="row align-items-center mb-3 print-only">      
                    <div class="col-12 col-md-8 mx-auto">
                        <h5 class="text-center">
                            <strong>Compétition {{ competition.name }}</strong></br>
                                {{ competition.startDate|format_datetime(locale='fr', pattern='dd MMMM') }} au 
                                {{ competition.endDate|format_datetime(locale='fr', pattern='dd MMMM YYYY') }}  - 
                        </h5>
                    </div>
                </div> 
                <div class="col-12 col-lg-6 mt-4 page-break">
                    <h5 class="text-center">
                        <strong>
                            Catégorie
                            <a href="{{ path('test_results_per_category',{ id: competition.id, category: category }) }}"
                                class="text-primary text-decoration-underline fw-bold d-inline-flex align-items-center sort-column"
                                style="white-space: nowrap;"
                                title="Voir par categorie {{ category }}">
                                {{ category }}
                            </a>
                       </strong>
                    </h5>
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm mt-4 print-table">
                            <thead>
                                <tr>
                                    <th>Class.</th>
                                    <th>
                                        {% if competition.typecompetition.id == 2 %}
                                            Pilote
                                        {% else %}
                                            Équipage                            
                                        {% endif %}
                                    </th>
                                    {% for testId, test in testNames %}
                                        {% set hasResults = test.hasDetail and testsWithResults[testId] is defined %}
                                        <th class="text-center {% if hasResults %}sort-column{% endif %}" data-key="{{ loop.index }}">
                                            {% if hasResults %}
                                                <a href="{{ path('test_results_detail', { testId: testId }) }}"
                                                    class="text-primary text-decoration-underline fw-bold d-inline-flex align-items-center sort-column"
                                                    data-key="{{ loop.index }}"
                                                    style="white-space: nowrap;"
                                                    title="Voir les détails de {{ test.label }}">
                                                    {{ test.label }}
                                                    <i class="fa-solid fa-sort sort-arrow ms-2" style="cursor:pointer;"></i>
                                                </a>
                                            {% else %}
                                                <span class="fw-bold text-muted" title="Pas de détail">{{ test.label }}</span>
                                            {% endif %}
                                        </th>
                                    {% endfor %}
                                    <th class="text-center sort-column" data-key="total">
                                        <span class="fw-bold" style="white-space: nowrap;">
                                            Total <i class="fa-solid fa-sort sort-arrow ms-2"></i>
                                        </span>
                                    </th>                            
                                </tr>
                            </thead>
                <tbody> 
    {% set lastScore = null %}
    {% set rank = 1 %}
    {% set actualRank = 0 %}  

    {% for crewData in crews %}
        {% set actualRank = actualRank + 1 %}

        {# Si DNS global, on ne touche pas le rang #}
        {% if not crewData.dns %}
            {% if crewData.total != lastScore %}
                {% set rank = actualRank %}
            {% endif %}
        {% endif %}

        <tr data-score="{{ crewData.total }}">
            <td class="text-center">
                {% if crewData.dns %}
                    –
                {% else %}
                    {{ rank }}
                {% endif %}
            </td>

            <td>
                {% if crewData.crew.pilot is defined %}   
                    {% if competition.typecompetition.id == 2 %}
                        {{ crewData.crew.pilot.lastName }} {{ crewData.crew.pilot.firstName }}
                    {% else %}
                        {{ crewData.crew.pilot.lastName }} {{ crewData.crew.pilot.firstName }}<br>
                        {{ crewData.crew.navigator.lastName }} {{ crewData.crew.navigator.firstName }}                           
                    {% endif %}    
                {% else %}
                    {{ crewData.crew }}
                {% endif %}
            </td>

            {# Colonnes par épreuve/test #}
            {% for testKey, displayName in testNames %}
                {% set result = crewData.tests[testKey] ?? {'nav': null, 'att': null, 'total': null, 'dns': false} %}                                            

                {% if result.dns %}
                    <td data-key="{{ loop.index }}" class="text-center">DNS</td>
                {% elseif competition.typecompetition.id == 2 %}
                    {% if result.att is not null %}
                        <td data-key="{{ loop.index }}" data-value="{{ result.att }}">{{ result.att }}</td>
                    {% elseif result.nav is not null %}
                        <td data-key="{{ loop.index }}" data-value="{{ result.nav }}">{{ result.nav }}</td>
                    {% else %}
                        <td class="text-muted">—</td>
                    {% endif %}
                {% else %}
                    <td data-key="{{ loop.index }}" data-value="{{ result.nav }}">
                        {% if result.total is not null %}
                            {{ result.nav }}
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>                                            
                {% endif %}
            {% endfor %}

            {# Colonne Total #}
            <td class="text-center" data-key="total" data-value="{{ crewData.total }}">
                {% if crewData.dns %}
                    <strong class="text-muted">--</strong>
                {% else %}
                    <strong>{{ crewData.total }}</strong>
                {% endif %}        
            </td>
        </tr>

        {% if not crewData.dns %}
            {% set lastScore = crewData.total %}
        {% endif %}                             
    {% endfor %}
</tbody>
                        </table>
                    </div>
                </div>
            {% endfor %}
        </div>    
    </div>
    <script>
        document.querySelectorAll('.table').forEach(table => {
            const headers = table.querySelectorAll('.sort-column');

            headers.forEach((header) => {
                const icon = header.querySelector('.sort-arrow');
                let ascending = true;
                const key = header.dataset.key;

                if (icon && key) {
                    icon.addEventListener('click', (event) => {
                        event.preventDefault();
                        event.stopPropagation();

                        const tbody = table.querySelector('tbody');
                        const rows = Array.from(tbody.querySelectorAll('tr'));

                        rows.sort((a, b) => {
                            const aCell = a.querySelector(`td[data-key="${key}"]`);
                            const bCell = b.querySelector(`td[data-key="${key}"]`);

                            const aVal = parseFloat(aCell?.getAttribute('data-value') || 0);
                            const bVal = parseFloat(bCell?.getAttribute('data-value') || 0);

                            return ascending ? aVal - bVal : bVal - aVal;
                        });

                        ascending = !ascending;
                        rows.forEach(row => tbody.appendChild(row));

                        headers.forEach(h => {
                            const i = h.querySelector('.sort-arrow');
                            if (i) {
                                i.classList.remove('fa-sort-up', 'fa-sort-down');
                                i.classList.add('fa-sort');
                            }
                        });
                        icon.classList.remove('fa-sort');
                        icon.classList.add(ascending ? 'fa-sort-up' : 'fa-sort-down');

                        if (key === 'total') {
                            let previousScore = null;
                            let rank = 0;
                            let displayRank = 0;

                            rows.forEach((row) => {
                                const score = parseFloat(row.getAttribute('data-score') || 0);
                                rank++;
                                if (score !== previousScore) {
                                    displayRank = rank;
                                }

                                const rankCell = row.children[0];
                                if (rankCell) {
                                    rankCell.textContent = displayRank;
                                }

                                previousScore = score;
                            });
                        } else {
                            rows.forEach((row, i) => {
                                const rankCell = row.children[0];
                                if (rankCell) {
                                    rankCell.textContent = i + 1;
                                }
                            });
                        }
                    });
                }
            });
        });
    </script>

{% endblock %}