{% extends '_partials/_results_base.html.twig' %}

{% block title %}Résultats{% endblock %}

{% block result_content %}

    <div class="container-fluid mt-4 no-print">
        {# ----------- Header écran ----------- #}
        <div class="row align-items-center mb-3 no-print">
            <div class="col-2">
                <img src="{{ asset('images/logo_ffa_sports.png') }}" style="max-height: 80px;">
            </div>

            <div class="col-7 text-center">
                <strong>Compétition {{ competition.name }}</strong><br>
                {{ competition.startDate|format_datetime(locale='fr', pattern='dd MMMM') }}
                au {{ competition.endDate|format_datetime(locale='fr', pattern='dd MMMM YYYY') }}
            </div>

            <div class="col-3 text-end">
                <button onclick="window.print()">🖨️ Imprimer</button>
                <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
                    <i class="fa-solid fa-arrow-left me-1"></i> Retour
                </a>
            </div>
        </div>

        {# ----------- Tables écran ----------- #}
        <div class="row g-3 no-print">
            {% for category, crews in scoreByCategory %}
                <div class="col-12 col-lg-6">
                    <h6 class="fw-bold text-center mb-2">
                        <a href="{{ path('test_results_per_category',{ id: competition.id, category: category }) }}"
                                class="text-primary text-decoration-underline fw-bold d-inline-flex align-items-center sort-column"
                            style="white-space: nowrap;"
                            title="Voir par categorie {{ category }}">
                            {{ category }}
                        </a>       
                    </h6>
                    {% include '_partials/_results_generals_table.html.twig' with { 'crews': crews, 'competition': competition, 'testNames': testNames } %}                      
                </div>
            {% endfor %}
        </div>
    </div>

    {# ----------- Impression ----------- #}
    <div class="print-content">
        {% for category, crews in scoreByCategory %}
            <div class="print-category">

                <div class="print-header">
                    <div class="print-logo">
                        <img src="{{ asset('images/logo_ffa_sports.png') }}" style="max-height:60px;">
                    </div>

                    <div class="print-title">
                        <strong>Compétition {{ competition.name }}</strong><br>
                        {{ competition.startDate|format_datetime(locale='fr', pattern='dd MMMM') }}
                        au {{ competition.endDate|format_datetime(locale='fr', pattern='dd MMMM YYYY') }}
                        <br><br>
                        <strong>Catégorie : {{ category }}</strong>
                    </div>
                </div>

                {% include '_partials/_results_generals_table.html.twig' with {
                    'crews': crews,
                    'competition': competition,
                    'testNames': testNames
                } %}

            </div>
        {% endfor %}
    </div>

    {# ----------- Script tri actif ----------- #}
    <script>
        document.querySelectorAll('.table').forEach(table => {
            const headers = table.querySelectorAll('.sort-column');

            headers.forEach(header => {
                const icon = header.querySelector('.sort-arrow');
                let ascending = true;
                const key = header.dataset.key;

                if (icon && key) {
                    icon.addEventListener('click', e => {
                        e.preventDefault();
                        e.stopPropagation();
                        const tbody = table.querySelector('tbody');
                        const rows = Array.from(tbody.querySelectorAll('tr'));

                        rows.sort((a, b) => {
                            const aCell = a.querySelector(`td[data-key="${key}"]`);
                            const bCell = b.querySelector(`td[data-key="${key}"]`);
                            const aVal = parseFloat(aCell?.dataset.value ?? aCell?.textContent ?? -1);
                            const bVal = parseFloat(bCell?.dataset.value ?? bCell?.textContent ?? -1);
                            return ascending ? aVal - bVal : bVal - aVal;
                        });

                        ascending = !ascending;
                        rows.forEach(row => tbody.appendChild(row));

                        headers.forEach(h => {
                            const i = h.querySelector('.sort-arrow');
                            if(i) { i.classList.remove('fa-sort-up','fa-sort-down'); i.classList.add('fa-sort'); }
                        });
                        icon.classList.remove('fa-sort');
                        icon.classList.add(ascending ? 'fa-sort-up' : 'fa-sort-down');

                        if (key === 'total') {
                            let previousScore = null, rank = 0, displayRank = 0;
                            rows.forEach(row => {
                                const score = parseFloat(row.dataset.score ?? -1);
                                rank++;
                                if(score !== previousScore) displayRank = rank;
                                row.children[0].textContent = displayRank;
                                previousScore = score;
                            });
                        } else {
                            rows.forEach((row, i) => row.children[0].textContent = i+1);
                        }
                    });
                }
            });
        });
    </script>
{% endblock %}