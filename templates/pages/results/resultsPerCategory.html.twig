{# templates/results/results_per_category.html.twig #}
{% extends '_partials/_results_base.html.twig' %}

{% block title %}Résultats par catégorie{% endblock %}

{% block result_content %}

    <div class="container-fluid mt-4 no-print">
        {# ----------- Header écran ----------- #}
        <div class="row align-items-center mb-3 no-print">
            <div class="text-end">
                <button onclick="window.print()">🖨️ Imprimer</button>
                <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
                    <i class="fa-solid fa-arrow-left me-1"></i> Retour
                </a>
            </div>
        </div>
  {# ----------- Tables écran -----------       #}
        <div class="row g-3 no-print">                 
            {% include '_partials/_results_category_table.html.twig' %}              
        </div>
    </div>

    <div class="print-content">
        {% include '_partials/_results_category_table.html.twig' %}
    </div> 

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const table = document.querySelector('table');
            const rows = Array.from(table.querySelectorAll('tbody tr'));
            let currentSort = { key: null, asc: true };

            document.querySelectorAll('th.sort-column').forEach(th => {
                th.addEventListener('click', () => {
                    const key = th.dataset.key;
                    const asc = currentSort.key === key ? !currentSort.asc : true;

                    rows.sort((a, b) => {
                        const aVal = parseFloat(a.querySelector(`td[data-key="${key}"]`)?.dataset.value || 0);
                        const bVal = parseFloat(b.querySelector(`td[data-key="${key}"]`)?.dataset.value || 0);
                        return asc ? aVal - bVal : bVal - aVal;
                    });

                    rows.forEach(row => table.querySelector('tbody').appendChild(row));
                    currentSort = { key, asc };
                });
            });
        });
    </script>
{% endblock %}