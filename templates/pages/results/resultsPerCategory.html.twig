{# templates/results/results_per_category.html.twig #}
{% extends '_partials/_results_base.html.twig' %}

{% block title %}Résultats par catégorie{% endblock %}

{% block result_content %}

    <div class="container-fluid mt-4 no-print">
        {# ----------- Header écran ----------- #}
        <div class="row align-items-center mb-3 no-print">
            <div class="text-end">
                <button onclick="window.print()">🖨️ Imprimer</button>
                <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
                    <i class="fa-solid fa-arrow-left me-1"></i> Retour
                </a>
            </div>
        </div>
  {# ----------- Tables écran -----------       #}
        <div class="row g-3 no-print">                 
            {% include '_partials/_results_category_table.html.twig' %}              
        </div>
    </div>

    <div class="print-content">
        {% include '_partials/_results_category_table.html.twig' %}
    </div> 

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            document.querySelectorAll('.sort-column').forEach(header => {

                let ascending = true;

                header.addEventListener('click', function () {

                    const table = header.closest('table');
                    const tbody = table.querySelector('tbody');
                    const rows = Array.from(tbody.querySelectorAll('tr'));

                    const key = header.dataset.key;

                    rows.sort((a, b) => {

                        const aCell = a.querySelector(`td[data-key="${key}"]`);
                        const bCell = b.querySelector(`td[data-key="${key}"]`);

                        const aVal = parseFloat(aCell?.dataset.value ?? -1);
                        const bVal = parseFloat(bCell?.dataset.value ?? -1);

                        return ascending ? aVal - bVal : bVal - aVal;
                    });

                    ascending = !ascending;

                    rows.forEach(row => tbody.appendChild(row));

                    // reset icons
                    document.querySelectorAll('.sort-arrow').forEach(icon => {
                        icon.classList.remove('fa-sort-up','fa-sort-down');
                        icon.classList.add('fa-sort');
                    });

                    const icon = header.querySelector('.sort-arrow');
                    icon.classList.remove('fa-sort');
                    icon.classList.add(ascending ? 'fa-sort-up' : 'fa-sort-down');

                    // recalcul du classement
                    rows.forEach((row, index) => {
                        row.children[0].textContent = index + 1;
                    });

                });

            });

        });
    </script>
{% endblock %}