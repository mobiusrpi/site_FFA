{% extends 'base.html.twig' %}

{% block title %}Résultats {% endblock %}

{% block body %}
<div class="container mt-4">

  <div class="row gx-4">
    {% for category, results in rankingByCategory %}    
      <div class="col-md-6 mb-4">
        <div class="text-center">
          <h5><strong>Catégorie {{ category }}</strong></h5>
        </div>          

        <table class="table table-bordered table-sm">
          <thead>
            <tr>
              <th>Class.</th>
              <th>Équipage</th>
              <th>Nav</th>
              <th>Obs</th>              
              <th>Att</th>             
              <th>Théo</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            {% for row in results %}
              <tr>
                <td>{{ loop.index }}</td>
                <td style="white-space: nowrap;">
                  <small>
                    {{ row.crew.pilot.lastName }} {{ row.crew.pilot.firstName }}<br>
                    {{ row.crew.navigator.lastName }} {{ row.crew.navigator.firstName }}
                  </small>
                </td>
                <td>{{ row.navigation }}</td>
                <td>{{ row.observation }}</td>
                <td>{{ row.landing }}</td>                
                <td>{{ row.flightPlanning }}</td>
                <td>{{ row.total }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endfor %}
  </div>

</div>
{% endblock %}
