{% extends 'base.html.twig' %}


{% block title %}          
    Scores
{% endblock %}

{% block body %}
  <style>
    @media print {
        .page-break {
            page-break-after: always;
        }
    }
    @media print {
        .no-print {
            display: none !important;
        }
        .print-only {
            display: block !important;
        }
    }   
    @media screen {
        .print-only {
            display: none;
        }
    }
    /* Règles générales */
    table.print-table {
      border-collapse: collapse;
      width: 100%;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    /* Bordures plus foncées / épaisses pour impression */
    @media print {
      table.print-table th,
      table.print-table td {
        border: 2px solid #000 !important;   /* 2px = plus épais */
        padding: 4px;                        /* ajuster l'espacement */
        background-color: white !important;  /* garantir fond blanc si besoin */
      }
      table.print-table thead th {
        background-color: silver !important; /* si tu veux en-tête gris */
      }
      /* cacher éléments non imprimables */
      .no-print { display: none !important; }
    }
  </style>

  <div class="container-fluid mt-4">
      <div class="row align-items-center mb-3 no-print">      
          <div class="col-12 col-md-8 mx-auto">
              <h5 class="text-center">
                  <strong>Compétition {{ competition.name }}</strong></br>
                      {{ competition.startDate|format_datetime(locale='fr', pattern='dd MMMM') }} au 
                      {{ competition.endDate|format_datetime(locale='fr', pattern='dd MMMM YYYY') }}  - 
                  <strong>{{ test }}</strong>
              </h5>
          </div>
          <div class="col-12 col-md-4 text-center text-md-end mt-2 mt-md-0">
            <button onclick="window.print()">🖨️ Imprimer</button>
              <a  href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
                  <i class="fa-solid fa-arrow-left me-1"></i> Retour
              </a>
          </div>
      </div>    
      <div class="row g-0">
        {% for category, results in rankingByCategory %}    
          <div class="row align-items-center mb-3 print-only">      
              <div class="col-12 col-md-8 mx-auto">
                  <h5 class="text-center">
                      <strong>Compétition {{ competition.name }}</strong></br>
                          {{ competition.startDate|format_datetime(locale='fr', pattern='dd MMMM') }} au 
                          {{ competition.endDate|format_datetime(locale='fr', pattern='dd MMMM YYYY') }}  - 
                      <strong>{{ test }}</strong>
                  </h5>
              </div>
          </div> 
          <div class="col-12 col-lg-6 px-1 mb-4 page-break">
            <div class="text-center">
              <h5><strong>Catégorie {{ category }}</strong></h5>
            </div>          
            <div class="table-responsive">
              <table class="table table-bordered table-sm print-table">
                <thead>
                  <tr>
                    <th>Class.</th>
                    <th>Équipage</th>
                    <th class='text-center'>Nav</th>
                    {% if competition.typecompetition.id != 3 %}
                      <th>Obs</th>
                    {% endif %}
                    <th class='text-center'>    
                      {% if competition.typecompetition.id == 2 %}
                        Théo
                      {% else %}
                        Att
                      {% endif %}
                    </th>
                    <th class='text-center'>Total</th>
                  </tr>
                </thead>
                <tbody>
                  {% set lastScore = null %}
                  {% set rank = 1 %}
                  {% set actualRank = 0 %}    
                  {% for row in results %}
                    {% set actualRank = actualRank + 1 %}
                    {% if row.total != lastScore %}
                      {% set rank = actualRank %}
                    {% endif %}
                    <tr>
                      <td class="text-center">{{ rank }}</td>
                      <td style="white-space: nowrap;">
                        <small>
                          {% if row.crew.pilot is defined %}  
                            {% if competition.typecompetition.id  == 2 %}
                              {{ row.crew.pilot.lastName }} {{ row.crew.pilot.firstName }}<br>
                            {% else %}
                              {{ row.crew.pilot.lastName }} {{ row.crew.pilot.firstName }}<br>
                              {{ row.crew.navigator.lastName }} {{ row.crew.navigator.firstName }}
                            {% endif %}
                          {% else %}
                            {{ row.crew }}
                          {% endif %}
                        </small>
                      </td>
                      <td class='text-center'>{{ row.navigation }}</td>
                                        
                      {% if competition.typecompetition.id != 3 %}
                        <td>{{ row.observation }}</td>              
                      {% endif %}
                      <td class='text-center'>
                        {% if competition.typecompetition.id == 2 %}
                          {{ row.flightPlanning }}
                        {% else %}
                          {{ row.landing }}
                        {% endif %}                 
                      </td>  
                      <td class='text-center'>{{ row.total }}</td>
                    </tr>
                    {% set lastScore = row.total %}
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </div>
        {% endfor %}
      </div>
  </div>
{% endblock %}
