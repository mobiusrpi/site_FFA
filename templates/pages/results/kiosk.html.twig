{% extends 'base_kiosk.html.twig' %}

{% block title %}Résultats en direct – {{ testName }}{% endblock %}

{% block body %}
<div class="container py-4">
    <h2 class="text-center mb-4">Résultats – {{ testName }}</h2>

    <div class="row">
        {% for category in ['elite', 'honneur'] %}
            <div class="col-md-6 mb-4">
                <h4 class="text-center text-uppercase">{{ category }}</h4>
                <div class="table-responsive">
                    <table class="table table-bordered table-sm text-center" id="table-{{ category }}">
                        <thead class="table-dark">
                            <tr>
                                <th>Rang</th>
                                <th>Équipage</th>
                                <th>Points</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td colspan="3"><em>Chargement...</em></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    async function loadData() {
        try {
            const response = await fetch('{{ path('results_data_json', { testId: testId }) }}');
            const data = await response.json();
            updateTable('elite', data.elite);
            updateTable('honneur', data.honneur);
        } catch (e) {
            console.error("Erreur lors du chargement des résultats :", e);
        }
    }

    function updateTable(category, rows) {
        const tbody = document.querySelector(`#table-${category} tbody`);
        tbody.innerHTML = '';

        if (rows.length === 0) {
            tbody.innerHTML = '<tr><td colspan="3"><em>Aucun résultat</em></td></tr>';
            return;
        }

        rows.forEach((row, index) => {
            const tr = document.createElement('tr');

            let cssClass = '';
            if (row.rank === 1) cssClass = 'bg-warning text-dark fw-bold';       // Or
            else if (row.rank === 2) cssClass = 'bg-silver text-dark fw-bold';   // Argent
            else if (row.rank === 3) cssClass = 'bg-bronze text-dark fw-bold';  // Bronze

            tr.innerHTML = `
                <td class="${cssClass} text-center">${row.rank}</td>
                <td class="${cssClass} text-start">
                    <small>${row.pilot ?? ''}<br>${row.navigator ?? ''}</small>
                </td>
                <td class="${cssClass} text-center">${row.total}</td>
            `;

            tbody.appendChild(tr);
        });
    }

    loadData();
    setInterval(loadData, 10000);
</script>

<style>
    .bg-silver {
        background-color: #c0c0c0;
    }

    .bg-bronze {
        background-color: #cd7f32;
    }
</style>
{% endblock %}