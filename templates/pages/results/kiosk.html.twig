{% extends 'base_kiosk.html.twig' %}

{% block title %}Résultats en direct – {{ testName }}{% endblock %}

{% block body %}
    <style>
        .bg-silver {
            background-color: #c0c0c0;
        }

        .bg-bronze {
            background-color: #cd7f32;
        }
        .scroll-container {
            max-height: 300px;
            overflow-y: auto;
            scrollbar-gutter: stable;
        }
    </style>
    <div class="row align-items-center mb-3 no-print">
        <div class="col-md-2 col-12 text-center text-md-start">
            <img src="{{ asset('images/logo_ffa_sports.png') }}" style="max-height:80px; max-width:100%;">
        </div>
        <div class="col-md-10 col-12 text-center">
            <h3 class="text-center">
                <strong>Compétition {{ competition.name }}</strong></br> 
            </h3>
            <h2 class="text-center mb-4">
                {% if resultsValidated %} 
                    Résultats – 
                {% else %}
                    Résultats provisoires – 
                {% endif %}
                {{ testName }}
            </h2>
        </div>
        <div class="row">
            {% for categoryKey, rows in scoreByCategory %}
                <div class="col-md-6 mb-4">
                    <h4 class="text-center text-uppercase">{{ categoryKey }}</h4>
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm text-center table-striped">
                            <thead class="table-secondary">
                                <tr>
                                    <th>Rang</th>
                                    <th>Équipage</th>
                                    <th>Pénalités</th>
                                </tr>
                            </thead>
                        </table>

                        <!-- TOP 3 FIXE -->
                        <table class="table table-bordered table-sm text-center table-striped mb-0">
                            <colgroup>
                                <col style="width: 10%">
                                <col style="width: 75%">
                                <col style="width: 15%">
                            </colgroup>                            
                            <tbody id="top3-{{ categoryKey }}"></tbody>
                        </table>

                        <!-- SCROLL -->
                        <div class="scroll-container">
                            <table class="table table-bordered table-sm text-center table-striped">
                                <colgroup>
                                    <col style="width: 10%">
                                    <col style="width: 75%">
                                    <col style="width: 15%">
                                </colgroup>
                                <tbody id="scroll-{{ categoryKey }}"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        let lastData = null;

        async function loadData() {
            const response = await fetch('{{ path('results_data_json', { testId: testId }) }}');
            const data = await response.json();

            if (JSON.stringify(data) === JSON.stringify(lastData)) {
                return; // rien n'a changé
            }

            lastData = data;

            updateTable('elite', data.elite ?? []);
            updateTable('honneur', data.honneur ?? []);
        }

        function updateTable(category, rows) {
            const top3 = document.querySelector(`#top3-${category}`);
            const scroll = document.querySelector(`#scroll-${category}`);

            top3.innerHTML = '';
            scroll.innerHTML = '';

            if (rows.length === 0) {
                scroll.innerHTML = '<tr><td colspan="3"><em>Aucun résultat</em></td></tr>';
                return;
            }

            rows.forEach((row, index) => {
                const tr = document.createElement('tr');

                let cssClass = '';
                if (row.rank === 1) cssClass = 'bg-warning text-dark fw-bold';
                else if (row.rank === 2) cssClass = 'bg-silver text-dark fw-bold';
                else if (row.rank === 3) cssClass = 'bg-bronze text-dark fw-bold';

                tr.innerHTML = `
                    <td class="${cssClass}">${row.rank}</td>
                    <td class="${cssClass} text-start">
                        <small>${row.pilot ?? ''}<br>${row.navigator ?? ''}</small>
                    </td>
                    <td class="${cssClass}">${row.total}</td>
                `;

                if (index < 3) {
                    top3.appendChild(tr);
                } else {
                    scroll.appendChild(tr);
                }
            });

            startAutoScroll(category);
        }

        let scrollInterval = null;
        let isPaused = false;

        function startAutoScroll() {
            const c = document.querySelector('.scroll-container');
            if (!c) return;

            if (scrollInterval) {
                clearInterval(scrollInterval);
            }

            let direction = 1; // 1 = descendre, -1 = remonter (optionnel)
            let speed = 1;

            function pause(ms) {
                isPaused = true;
                setTimeout(() => {
                    isPaused = false;
                }, ms);
            }

            // 👉 pause au début
            c.scrollTop = 0;
            pause(2000);

            scrollInterval = setInterval(() => {
                if (isPaused) return;

                const max = c.scrollHeight - c.clientHeight;
                if (max <= 0) return;

                c.scrollTop += speed * direction;

                // 👉 arrivée en bas
                if (c.scrollTop >= max) {
                    c.scrollTop = max;
                    pause(2000);

                    // reset après pause
                    setTimeout(() => {
                        c.scrollTop = 0;
                        pause(2000); // pause en haut
                    }, 2000);
                }

            }, 30);
        }
        loadData();
        setInterval(loadData, 10000);
    </script>
{% endblock %}