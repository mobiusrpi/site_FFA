{% extends 'base_kiosk.html.twig' %}

{% block title %}Résultats en direct – {{ testName }}{% endblock %}

{% block body %}
    <style>
        .bg-silver {
            background-color: #c0c0c0;
        }

        .bg-bronze {
            background-color: #cd7f32;
        }
        .scroll-container {
            max-height: 300px;  
            overflow-y: auto;
            scrollbar-gutter: stable;
        }
        .kiosk-row {
            display: flex;
            gap: 20px;
        }

        .kiosk-col {
            flex: 1;
            min-width: 0; /* évite débordements */
        }

        /* Sécurité écran large */
        @media (min-width: 768px) {
            .kiosk-row {
                flex-direction: row;
            }
        }

        /* Mobile fallback */
        @media (max-width: 767px) {
            .kiosk-row {
                flex-direction: column;
            }
        }
        .kiosk-col h5 {
            text-align: center;
            font-size: 1.8rem;   /* taille bien visible */
            font-weight: bold;
            margin-bottom: 1àpx;
        }

        /* Version écran large (kiosk / TV) */
        @media (min-width: 1200px) {
            .kiosk-col h4 {
                font-size: 3rem;
            }
        }
        table {
            font-size: 1.2rem;
        }

        @media (min-width: 1200px) {
            table {
                font-size: 1.5rem;
            }
        }
    </style>
    <div style="display:flex; align-items:center; gap:20px; margin-bottom:20px;">

        <div style="flex:0 0 120px;">
            <img src="{{ asset('images/logo_ffa_sports.png') }}"
                style="max-height:80px; max-width:100%;">
        </div>

        <div style="flex:1; text-align:center;">
            <h3 style="margin:0;">
                <strong>Compétition {{ competition.name }}</strong>
            </h3>

            <h2 style="margin:0;">
                {% if resultsValidated %}
                    Résultats –
                {% else %}
                    Résultats provisoires –
                {% endif %}
                {{ testName }}
            </h2>
        </div>

    </div>
    <div class="kiosk-row">

        {% for categoryKey, rows in scoreByCategory %}           
            {% set categoryLabels = {
                'elite': 'Elite',
                'honneur': 'Honneur'
            } %}
            <div class="kiosk-col">
                <h5 class="text-center">
                    {{ categoryLabels[categoryKey]|default(categoryKey) }}
                </h5>
                <div class="table-responsive">
                    <table class="table table-bordered table-sm text-center table-striped">
                        <colgroup>
                            <col style="width: 10%">
                            <col style="width: 75%">
                            <col style="width: 15%">
                        </colgroup>

                        <thead class="table-secondary">
                            <tr>
                                <th>Rang</th>
                                <th>Équipage</th>
                                <th>Pénalités</th>
                            </tr>
                        </thead>

                        <tbody id="table-{{ categoryKey }}"></tbody>
                    </table>
                </div>
            </div>
        {% endfor %}
    </div>

{% endblock %}

{% block javascripts %}
    <script>
        let lastData = null;

        async function loadData() {
            const response = await fetch('{{ path('results_data_json', { testId: testId }) }}');
            const data = await response.json();

            console.log("DATA:", data);

            if (JSON.stringify(data) === JSON.stringify(lastData)) {
                return;
            }

            lastData = data;

            updateTable('elite', data.elite ?? []);
            updateTable('honneur', data.honneur ?? []);
        }

        function updateTable(category, rows) {
            const table = document.querySelector(`#table-${category}`);

            if (!table) {
                console.warn("Table non trouvée:", category);
                return;
            }

            table.innerHTML = '';

            if (rows.length === 0) {
                table.innerHTML = '<tr><td colspan="3"><em>Aucun résultat</em></td></tr>';
                return;
            }

            rows.forEach((row) => {
                const tr = document.createElement('tr');

                let cssClass = '';
                if (row.rank === 1) cssClass = 'bg-warning text-dark fw-bold';
                else if (row.rank === 2) cssClass = 'bg-silver text-dark fw-bold';
                else if (row.rank === 3) cssClass = 'bg-bronze text-dark fw-bold';

                tr.innerHTML = `
                    <td class="${cssClass}">${row.rank}</td>
                    <td class="${cssClass} text-start">
                        <small>${row.pilot ?? ''}<br>${row.navigator ?? ''}</small>
                    </td>
                    <td class="${cssClass}">${row.total}</td>
                `;

                table.appendChild(tr);
            });
        }

        loadData();
        setInterval(loadData, 10000);
    </script>
{% endblock %}