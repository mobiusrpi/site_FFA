{% extends 'base_kiosk.html.twig' %}

{% block title %}Résultats en direct – {{ testName }}{% endblock %}

{% block body %}
    <style>
        .bg-silver {
            background-color: #c0c0c0;
        }

        .bg-bronze {
            background-color: #cd7f32;
        }
        .scroll-container {
            max-height: 300px;  
            overflow-y: auto;
            scrollbar-gutter: stable;
        }
        .kiosk-row {
            display: flex;
            gap: 20px;
        }

        .kiosk-col {
            flex: 1;
            min-width: 0; /* évite débordements */
        }

        /* Sécurité écran large */
        @media (min-width: 768px) {
            .kiosk-row {
                flex-direction: row;
            }
        }

        /* Mobile fallback */
        @media (max-width: 767px) {
            .kiosk-row {
                flex-direction: column;
            }
        }
    </style>
    <div class="row align-items-center mb-3 no-print">
        <div class="col-md-2 col-12 text-center text-md-start">
            <img src="{{ asset('images/logo_ffa_sports.png') }}" style="max-height:80px; max-width:100%;">
        </div>
        <div class="col-md-10 col-12 text-center">
            <h3 class="text-center">
                <strong>Compétition {{ competition.name }}</strong></br> 
            </h3>
            <h2 class="text-center mb-4">
                {% if resultsValidated %} 
                    Résultats – 
                {% else %}
                    Résultats provisoires – 
                {% endif %}
                {{ testName }}
            </h2>
        </div>
        <div class="kiosk-row">
            {% for categoryKey, rows in scoreByCategory %}
                <div class="kiosk-col">
                    <h4 class="text-center text-uppercase">{{ categoryKey }}</h4>

                    <div class="table-responsive">
                        <table class="table table-bordered table-sm text-center table-striped">
                            <colgroup>
                                <col style="width: 10%">
                                <col style="width: 75%">
                                <col style="width: 15%">
                            </colgroup>

                            <thead class="table-secondary">
                                <tr>
                                    <th>Rang</th>
                                    <th>Équipage</th>
                                    <th>Pénalités</th>
                                </tr>
                            </thead>

                            <tbody id="table-{{ categoryKey }}"></tbody>
                        </table>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        console.log("JS chargé !");

        let lastData = null;

        async function loadData() {
            const response = await fetch('{{ path('results_data_json', { testId: testId }) }}');
            const data = await response.json();

            console.log("DATA:", data);

            if (JSON.stringify(data) === JSON.stringify(lastData)) {
                return;
            }

            lastData = data;

            updateTable('elite', data.elite ?? []);
            updateTable('honneur', data.honneur ?? []);
        }

        function updateTable(category, rows) {
            const table = document.querySelector(`#table-${category}`);

            if (!table) {
                console.warn("Table non trouvée:", category);
                return;
            }

            table.innerHTML = '';

            if (rows.length === 0) {
                table.innerHTML = '<tr><td colspan="3"><em>Aucun résultat</em></td></tr>';
                return;
            }

            rows.forEach((row) => {
                const tr = document.createElement('tr');

                let cssClass = '';
                if (row.rank === 1) cssClass = 'bg-warning text-dark fw-bold';
                else if (row.rank === 2) cssClass = 'bg-silver text-dark fw-bold';
                else if (row.rank === 3) cssClass = 'bg-bronze text-dark fw-bold';

                tr.innerHTML = `
                    <td class="${cssClass}">${row.rank}</td>
                    <td class="${cssClass} text-start">
                        <small>${row.pilot ?? ''}<br>${row.navigator ?? ''}</small>
                    </td>
                    <td class="${cssClass}">${row.total}</td>
                `;

                table.appendChild(tr);
            });
        }

        loadData();
        setInterval(loadData, 10000);
    </script>
{% endblock %}