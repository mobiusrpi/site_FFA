{% extends 'base.html.twig' %}

{% block title %}Inscriptions{% endblock %}

{% block body %}
    <style>
        .min-width-70 {
            min-width: 70px;
        }
    </style>
    <section class='container mt-4' >
        <h3 class="h3 text-center font-weight-normal mb-3">Liste de mes inscriptions</h3> 
        {% for message in app.flashes('success') %}
            <div class="alert alert-success mt-4">
                {{message}}
            </div> 
        {% endfor %}
        <!-- Table for medium+ screens -->
        <table class="table table-striped d-none d-md-table">
            <thead class='table-light'>
                <tr>
                    <th class="text-center" scope="col"></th>
                    <th class="text-center" scope="col"></th>                 
                    <th class="text-center" scope="col"></th>              
                    <th class="text-center" scope="col" colspan="2">Inscription</th> 
                    <th class="text-center" scope="col" colspan="2">Compétition</th>              
                    {% if is_granted('ROLE_USER') %}
                    <th class="text-center"></th>
                    {% endif %}
                </tr>
                <tr>
                    <th class="text-center" scope="col">Désignation</th>
                    <th class="text-center" scope="col">Type</th>
                    <th class="text-center" scope="col">Lieu</th>
                    <th class="text-center min-width-70" scope="col">Début</th> 
                    <th class="text-center min-width-70" scope="col">Fin</th>                
                    <th class="text-center" scope="col">Début</th>
                    <th class="text-center" scope="col">Fin</th>
                    {% if is_granted('ROLE_USER') %}
                    <th class="text-center" scope="col">Actions</th>
                    {% endif %}
                </tr>
            </thead>
            <tbody>
                {% for crew in crews %}
                    <tr>
                        <th scope="row">
                            {{ crew.competition.name }}
                        </th>
                        <td>
                            {{ crew.competition.typecompetition.typeComp }}
                        </td>
                        <td>
                            {{ crew.competition.location }}
                        </td>
                        <td class="text-center min-width-70">
                            {{ crew.competition.startRegistration|date('d-m') }}
                        </td>
                        <td class="text-center min-width-70">
                            {{ crew.competition.endRegistration|date('d-m') }}
                        </td>
                        <td>
                            {{ crew.competition.startDate|format_datetime(locale='fr', pattern='dd MMMM YYYY') }}
                        </td>
                        <td>
                            {{ crew.competition.endDate|format_datetime(locale='fr', pattern='dd MMMM YYYY') }}
                        </td>
                        {% if is_granted('ROLE_USER') %}
                            <td>
                                <div class="d-flex justify-content-center gap-2">
                                    {% if date('now') <= crew.competition.endDate %}
                                        <a href="{{ path('edit_crew', {'competId': crew.competition.id}) }}"
                                        class="btn btn-outline-success btn-sm"
                                        title="Modifier l'inscription">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>

                                        <form method="post"
                                            action="{{ path('crews_delete', {'competId': crew.competition.id}) }}"
                                            onsubmit="return confirm('Confirmer la suppression ?');">

                                            <input type="hidden" name="_token"
                                                value="{{ csrf_token('delete' ~ crew.competition.id) }}">

                                            <button class="btn btn-outline-danger btn-sm"
                                                    title="Supprimer l'inscription">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    {% elseif crew.hasDownloadFiles %} 
                                        <a href="{{ path('crew_download_all_files', {'crewId': crew.id}) }}"
                                        class="btn btn-outline-primary btn-sm"
                                        title="Télécharger les fichiers">
                                            <i class="fa-solid fa-download"></i>
                                        </a>
                                    {% else %}
                                       Résultats validés
                                    {% endif %}                                    
                                </div>
                            </td>
                        {% endif %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        <!-- Cards for small screens -->
        <div class="d-md-none">
            {% for crew in crews %}
                <div class="card mb-3 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">
                            {{ crew.competition.name }}
                        </h5>
                        <p class="card-text mb-1">
                            <strong>Type:</strong>
                            {{ crew.competition.typecompetition.typeComp }}
                        </p>
                        <p class="card-text mb-1">
                            <strong>Lieu:</strong>
                            {{ crew.competition.location }}
                        </p>
                        <p class="card-text mb-1">
                            <strong>Inscription:</strong>
                            {{ crew.competition.startRegistration|format_datetime(locale='fr', pattern='dd MMMM YYYY') }}
                            –
                            <span class="{{ crew.competition.endRegistration <= date('now') ? 'text-danger' : '' }}">
                                {{ crew.competition.endRegistration|format_datetime(locale='fr', pattern='dd MMMM YYYY') }}
                            </span>
                        </p>
                        <p class="card-text mb-2">
                            <strong>Compétition:</strong>
                            {{ crew.competition.startDate|format_datetime(locale='fr', pattern='dd MMMM YYYY') }}
                            –
                            {{ crew.competition.endDate|format_datetime(locale='fr', pattern='dd MMMM YYYY') }}
                        </p>
                        {% if is_granted('ROLE_USER') %}
                            <div class="d-flex flex-column gap-2 mt-3">
                                {% if date('now') <= crew.competition.endDate %}                                    <a href="{{ path('edit_crew', {'competId': crew.competition.id}) }}"
                                    class="btn btn-outline-success btn-sm">
                                        <i class="fa-solid fa-pen-to-square me-1"></i>
                                        Modifier
                                    </a>
                                    {% if crew.competition.startDate > date('now') %}
                                        <form method="post"
                                            action="{{ path('crews_delete', {'competId': crew.competition.id}) }}"
                                            onsubmit="return confirm('Confirmer la suppression de votre inscription ?');">

                                            <input type="hidden" name="_token"
                                                value="{{ csrf_token('delete' ~ crew.competition.id) }}">

                                            <button type="submit"
                                                    class="btn btn-outline-danger btn-sm">
                                                <i class="fa-solid fa-trash me-1"></i>
                                                Supprimer
                                            </button>
                                        </form>                 
                                    {% elseif crew.hasDownloadFiles %}
                                        <a href="{{ path('crew_download_all_files', {'crewId': crew.id}) }}"
                                        class="btn btn-outline-primary btn-sm">
                                            <i class="fa-solid fa-download me-1"></i>
                                            Télécharger
                                        </a>
                                    {% else %}
                                        Résultats validés
                                    {% endif %}
                                </div>                                      
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>                   
{% endblock %}